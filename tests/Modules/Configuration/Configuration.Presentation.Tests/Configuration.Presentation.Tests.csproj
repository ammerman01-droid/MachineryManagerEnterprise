      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Castle.Core" /> <!-- Explicit ref: see note in Directory.Packages.props -->
