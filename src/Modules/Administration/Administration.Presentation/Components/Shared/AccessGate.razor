@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

@if (isChecking)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (deniedMessage is not null)
{
    <MudAlert Severity="Severity.Error">@deniedMessage</MudAlert>
}
else
{
    @ChildContent
}

@code {
    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private bool isChecking = true;
    private string? deniedMessage;

    /// <summary>The permission the signed-in user must hold (e.g. "Profile.View"), or null for none.</summary>
    [Parameter]
    public string? Permission { get; set; }

    /// <summary>Comma-separated levels allowed to see the content (e.g. "Platform,Holding"); null allows Platform, Holding and Organization.</summary>
    [Parameter]
    public string? AllowedLevels { get; set; }

    /// <summary>Raised once with the caller's access information, before the content is rendered.</summary>
    [Parameter]
    public EventCallback<AccessInfo> OnLoaded { get; set; }

    /// <summary>The protected content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/users/me/access");

            if (!response.IsSuccessStatusCode)
            {
                deniedMessage = "دسترسی غیرمجاز — پروفایل فعالی برای حساب شما تعریف نشده است.";
                return;
            }

            var info = await response.Content.ReadFromJsonAsync<AccessInfo>(JsonOptions);

            if (info is null)
            {
                deniedMessage = "پاسخ نامعتبر از سرور.";
                return;
            }

            var allowed = (AllowedLevels ?? "Platform,Holding,Organization")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            if (!allowed.Contains(info.Level))
            {
                deniedMessage = "دسترسی غیرمجاز — سطح دسترسی شما اجازه استفاده از این بخش را نمی‌دهد.";
                return;
            }

            if (!string.IsNullOrEmpty(Permission) && !info.Has(Permission))
            {
                deniedMessage = "دسترسی غیرمجاز — پروفایل شما مجوز لازم برای این بخش را ندارد.";
                return;
            }

            await OnLoaded.InvokeAsync(info);
        }
        catch (Exception ex)
        {
            deniedMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isChecking = false;
        }
    }
}
