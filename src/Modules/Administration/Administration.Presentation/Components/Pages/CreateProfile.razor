@page "/admin/profiles/create"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>ایجاد پروفایل</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ایجاد پروفایل جدید</MudText>

<MudPaper Class="pa-4" Style="max-width:600px;">
    <MudForm @ref="form" @bind-IsValid="@isValid">
        <MudTextField @bind-Value="model.Name" Label="نام پروفایل" Required="true" RequiredError="نام پروفایل الزامی است." />
        
        <MudTextField @bind-Value="permissionInput" Label="دسترسی‌ها (با کاما جدا کنید)" 
                      HelperText="مثال: Asset.Create, Asset.View, Maintenance.Plan" Class="mt-4" />
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@(!isValid || isSubmitting)" Class="mt-4">
            @if (isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>ذخیره</span>
            }
        </MudButton>
        
        <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/profiles"))" Class="mt-4 mr-2">
            بازگشت
        </MudButton>
    </MudForm>
</MudPaper>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
}

@code {
    private MudForm? form;
    private bool isValid;
    private bool isSubmitting;
    private string? errorMessage;
    
    private CreateProfileModel model = new();
    private string permissionInput = string.Empty;

    private async Task SubmitAsync()
    {
        if (form is null || !isValid) return;
        
        isSubmitting = true;
        errorMessage = null;
        
        try
        {
            var permissions = permissionInput.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Trim())
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .ToList();

            var request = new { model.Name, Permissions = permissions };
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync("/api/v1/profiles", request);
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در ایجاد پروفایل: {content}";
                return;
            }

            Navigation.NavigateTo("/admin/profiles");
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class CreateProfileModel
    {
        public string Name { get; set; } = string.Empty;
    }
}