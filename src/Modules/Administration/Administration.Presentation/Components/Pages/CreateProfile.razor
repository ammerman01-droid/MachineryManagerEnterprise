@page "/admin/profiles/create"
@using global::Administration.Domain
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>ایجاد پروفایل</PageTitle>

<AccessGate Permission="Profile.Create" AllowedLevels="Platform,Holding" OnLoaded="@(info => access = info)">

    <MudText Typo="Typo.h4" Class="mb-4">ایجاد پروفایل جدید</MudText>

    <MudPaper Class="pa-4" Style="max-width:900px;">
        <MudForm @ref="form" @bind-IsValid="@isValid">
            <MudTextField @bind-Value="name" Label="نام پروفایل" Required="true"
                          RequiredError="نام پروفایل الزامی است." />

            @if (access?.IsPlatform == true)
            {
                <MudAutocomplete T="LookupItem" @bind-Value="selectedHolding" Label="هلدینگ مالک (خالی = پروفایل سطح پلتفرم)"
                                 Class="mt-4" SearchFunc="@SearchHoldingsAsync" ToStringFunc="@(item => item?.Name)"
                                 ResetValueOnEmptyText="true" MinCharacters="0" DebounceInterval="300"
                                 CoerceText="true" Clearable="true" />
            }

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">دسترسی‌ها</MudText>

            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>بخش</th>
                        @foreach (var action in PermissionCatalog.Actions)
                        {
                            <th style="text-align:center">@ActionLabel(action)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var section in PermissionCatalog.Sections)
                    {
                        <tr>
                            <td>@section.DisplayName</td>
                            @foreach (var action in PermissionCatalog.Actions)
                            {
                                var permission = PermissionCatalog.BuildPermission(section.Key, action);
                                <td style="text-align:center">
                                    @if (section.EffectiveActions.Contains(action))
                                    {
                                        <MudCheckBox T="bool" Value="@selectedPermissions.Contains(permission)"
                                                     ValueChanged="@((bool isChecked) => TogglePermission(permission, isChecked))" />
                                    }
                                    else
                                    {
                                        @* gam 6: this section does not offer the action
                                               (e.g. AuditLog is View-only) — render a disabled
                                               checkbox so the row stays column-aligned. *@
                                        <MudCheckBox T="bool" Value="false" Disabled="true" />
                                    }
                                </td>
                            }
                        </tr>
                        @foreach (var extraAction in section.ExtraActions)
                        {
                            var extraPermission = PermissionCatalog.BuildPermission(section.Key, extraAction);
                            <tr>
                                <td style="padding-inline-start:24px">@section.DisplayName — @ActionLabel(extraAction)</td>
                                <td colspan="4" style="text-align:center">
                                    <MudCheckBox T="bool" Value="@selectedPermissions.Contains(extraPermission)"
                                                 ValueChanged="@((bool isChecked) => TogglePermission(extraPermission, isChecked))" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync"
                       Disabled="@(!isValid || isSubmitting)" Class="mt-4">
                @if (isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>ذخیره</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/profiles"))"
                       Class="mt-4 mr-2">
                بازگشت
            </MudButton>
        </MudForm>
    </MudPaper>

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
    }

</AccessGate>

@code {
    private MudForm? form;
    private bool isValid;
    private bool isSubmitting;
    private string? errorMessage;
    private AccessInfo? access;
    private LookupItem? selectedHolding;
    private string name = string.Empty;

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private async Task<IEnumerable<LookupItem>> SearchHoldingsAsync(string? value, CancellationToken cancellationToken)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var url = string.IsNullOrWhiteSpace(value)
                ? "/api/v1/holdings?pageSize=25"
                : $"/api/v1/holdings?search={Uri.EscapeDataString(value)}&pageSize=25";
            var response = await client.GetAsync(url, cancellationToken);

            if (!response.IsSuccessStatusCode)
            {
                return Array.Empty<LookupItem>();
            }

            var content = await response.Content.ReadAsStringAsync(cancellationToken);
            return System.Text.Json.JsonSerializer.Deserialize<LookupSearchResponse>(content, JsonOptions)?.Items
                ?? Enumerable.Empty<LookupItem>();
        }
        catch (Exception)
        {
            return Array.Empty<LookupItem>();
        }
    }

    private sealed record LookupItem(Guid Id, string Name);

    private sealed class LookupSearchResponse
    {
        public List<LookupItem> Items { get; set; } = new();
    }
    private readonly HashSet<string> selectedPermissions = new();

    private void TogglePermission(string permission, bool isChecked)
    {
        if (isChecked)
        {
            selectedPermissions.Add(permission);
        }
        else
        {
            selectedPermissions.Remove(permission);
        }
    }

    private static string ActionLabel(string action) => action switch
    {
        "View" => "دیدن",
        "Create" => "ایجاد",
        "Edit" => "ویرایش",
        "Delete" => "حذف",
        "Register" => "ثبت",
        "Rebase" => "بازتنظیم",
        "Correct" => "اصلاح",
        "Freeze" => "قفل",
        "Install" => "نصب",
        "ReportFailure" => "اعلام خرابی",
        "Recover" => "بازیابی",
        "Remove" => "جدا کردن",
        "Archive" => "بایگانی",
        _ => action,
    };

    private async Task SubmitAsync()
    {
        if (form is null || !isValid) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            // Platform users choose the owning Holding (none = Platform-owned); everyone else
            // always creates profiles for their own Holding.
            Guid? holdingId = access?.IsPlatform == true ? selectedHolding?.Id : access?.HoldingId;
            var request = new { Name = name, Permissions = selectedPermissions.ToList(), HoldingId = holdingId };
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync("/api/v1/profiles", request);
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در ایجاد پروفایل: {content}";
                return;
            }

            Navigation.NavigateTo("/admin/profiles");
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
