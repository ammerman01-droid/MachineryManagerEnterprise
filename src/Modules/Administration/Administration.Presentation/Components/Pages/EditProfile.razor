@page "/admin/profiles/{ProfileId:guid}/edit"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>ویرایش پروفایل</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ویرایش پروفایل</MudText>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Style="max-width:600px;">
        <MudForm @ref="form" @bind-IsValid="@isValid">
            <MudTextField @bind-Value="model.Name" Label="نام پروفایل" Required="true" RequiredError="نام پروفایل الزامی است." />
            
            <MudTextField @bind-Value="permissionInput" Label="دسترسی‌ها (با کاما جدا کنید)" 
                          HelperText="مثال: Asset.Create, Asset.View, Maintenance.Plan" Class="mt-4" />
            
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@(!isValid || isSubmitting)" Class="mt-4">
                @if (isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>ذخیره</span>
                }
            </MudButton>
            
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/profiles"))" Class="mt-4 mr-2">
                بازگشت
            </MudButton>
        </MudForm>
    </MudPaper>
}

@code {
    /// <summary>
    /// The unique identifier of the profile being edited.
    /// </summary>
    [Parameter]
    public Guid ProfileId { get; set; }

    private MudForm? form;
    private bool isValid;
    private bool isSubmitting;
    private bool isLoading = true;
    private string? errorMessage;
    
    private EditProfileModel model = new();
    private string permissionInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/profiles/{ProfileId}");
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در بارگذاری پروفایل: {content}";
                isLoading = false;
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<ProfileItem>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (result is null)
            {
                errorMessage = "پاسخ نامعتبر از سرور.";
                isLoading = false;
                return;
            }

            model = new EditProfileModel
            {
                Name = result.Name
            };
            permissionInput = string.Join(", ", result.Permissions);
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (form is null || !isValid) return;
        
        isSubmitting = true;
        errorMessage = null;
        
        try
        {
            var permissions = permissionInput.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Trim())
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .ToList();

            var request = new { model.Name, Permissions = permissions };
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PutAsJsonAsync($"/api/v1/profiles/{ProfileId}", request);
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در ویرایش پروفایل: {content}";
                return;
            }

            Navigation.NavigateTo("/admin/profiles");
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class EditProfileModel
    {
        public string Name { get; set; } = string.Empty;
    }

    private sealed class ProfileItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
        public bool IsActive { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
    }
}