@page "/admin/users"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>مدیریت کاربران</PageTitle>

<AdminOnly>
    <MudText Typo="Typo.h4" Class="mb-4">کاربران سامانه</MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/admin/users/create"))" Class="mb-4">
        ایجاد کاربر جدید
    </MudButton>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
    }
    else
    {
        <MudTable Items="@users" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>نام کاربری</MudTh>
                <MudTh>عملیات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="نام کاربری">@context.UserName</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/admin/users/{context.Id}/assign-profile"))">
                        تخصیص پروفایل
                    </MudButton>
                    @if (context.IsActive)
    {
        <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => DeactivateUserAsync(context.Id))">
            غیرفعال‌سازی
        </MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => ActivateUserAsync(context.Id))">
            فعال‌سازی
        </MudButton>
    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</AdminOnly>

@code {
    private List<UserItem> users = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/users?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در دریافت کاربران: {content}";
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<UsersResponse>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            users = result?.Items?.ToList() ?? new List<UserItem>();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeactivateUserAsync(Guid id)
{
    errorMessage = null;
    try
    {
        var client = HttpClientFactory.CreateClient("InternalApi");
        var response = await client.PostAsync($"/api/v1/users/{id}/deactivate", null);
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"خطا در غیرفعال‌سازی کاربر: {await response.Content.ReadAsStringAsync()}";
            return;
        }
        await LoadUsersAsync();
    }
    catch (Exception ex)
    {
        errorMessage = $"خطا: {ex.Message}";
    }
}

private async Task ActivateUserAsync(Guid id)
{
    errorMessage = null;
    try
    {
        var client = HttpClientFactory.CreateClient("InternalApi");
        var response = await client.PostAsync($"/api/v1/users/{id}/activate", null);
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"خطا در فعال‌سازی کاربر: {await response.Content.ReadAsStringAsync()}";
            return;
        }
        await LoadUsersAsync();
    }
    catch (Exception ex)
    {
        errorMessage = $"خطا: {ex.Message}";
    }
}

    private sealed class UserItem
{
    public Guid Id { get; set; }
    public string UserName { get; set; } = string.Empty;
    public bool IsActive { get; set; }
}

    private sealed class UsersResponse
    {
        public List<UserItem> Items { get; set; } = new();
    }
}