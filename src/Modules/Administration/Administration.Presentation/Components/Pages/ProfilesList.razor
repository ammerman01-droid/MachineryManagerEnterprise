@page "/admin/profiles"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>مدیریت پروفایل‌ها</PageTitle>

<AdminOnly>

    <MudText Typo="Typo.h4" Class="mb-4">پروفایل‌های دسترسی</MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               OnClick="@(() => Navigation.NavigateTo("/admin/profiles/create"))" Class="mb-4">
        ایجاد پروفایل جدید
    </MudButton>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
    }
    else
    {
        <MudTable Items="@profiles" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>نام پروفایل</MudTh>
                <MudTh>دسترسی‌ها</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh>تاریخ ایجاد</MudTh>
                <MudTh>عملیات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="نام">@context.Name</MudTd>
                <MudTd DataLabel="دسترسی‌ها">@string.Join(", ", context.Permissions.Take(3))@(context.Permissions.Count > 3
                                    ? "..." : "")</MudTd>
                    <MudTd DataLabel="وضعیت">
                        <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                            @(context.IsActive ? "فعال" : "غیرفعال")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="تاریخ">@context.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                   OnClick="@(() => Navigation.NavigateTo($"/admin/profiles/{context.Id}/edit"))">
                            ویرایش
                        </MudButton>
                        @if (context.IsActive)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => DeactivateAsync(context.Id))">
                                غیرفعال‌سازی
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => ActivateAsync(context.Id))">
                                فعال‌سازی
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Error"
                                   Disabled="@(deletingProfileId == context.Id)"
                                   OnClick="@(() => DeleteAsync(context.Id))">
                            @if (deletingProfileId == context.Id)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {
                                <span>حذف</span>
                            }
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

    </AdminOnly>

@code {
    private List<ProfileItem> profiles = new();
    private bool isLoading = true;
    private string? errorMessage;
    private Guid? deletingProfileId;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfilesAsync();
    }

    private async Task LoadProfilesAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/profiles?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در دریافت پروفایل‌ها: {content}";
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<SearchProfilesResponse>(content, new
System.Text.Json.JsonSerializerOptions
            { PropertyNameCaseInsensitive = true });
            profiles = result?.Items?.ToList() ?? new List<ProfileItem>();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeactivateAsync(Guid id)
    {
        errorMessage = null;
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsync($"/api/v1/profiles/{id}/deactivate", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadProfilesAsync();
            }
            else
            {
                errorMessage = $"خطا در غیرفعال‌سازی: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    private async Task ActivateAsync(Guid id)
    {
        errorMessage = null;
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsync($"/api/v1/profiles/{id}/activate", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadProfilesAsync();
            }
            else
            {
                errorMessage = $"خطا در فعال‌سازی: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    /// <summary>
    /// Permanently deletes a Profile. The API blocks this (409) while
    /// the profile still has active user assignments and returns a
    /// message explaining that; that message is surfaced here as-is
    /// (chat, 2026-08-25).
    /// </summary>
    /// <param name="id">The identifier of the profile to delete.</param>
    private async Task DeleteAsync(Guid id)
    {
        deletingProfileId = id;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.DeleteAsync($"/api/v1/profiles/{id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadProfilesAsync();
            }
            else
            {
                var rawContent = await response.Content.ReadAsStringAsync();
                var friendlyMessage = TranslateDeleteError(rawContent);

                await DialogService.ShowMessageBox(
                    "امکان حذف وجود ندارد",
                    friendlyMessage,
                    yesText: "متوجه شدم");
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBox(
                "خطا",
                $"در ارتباط با سرور مشکلی پیش آمد: {ex.Message}",
                yesText: "متوجه شدم");
        }
        finally
        {
            deletingProfileId = null;
        }
    }

    /// <summary>
    /// Translates the API's ProblemDetails JSON into a friendly Persian
    /// message for the delete-profile dialog (chat, 2026-08-25).
    /// </summary>
    private static string TranslateDeleteError(string rawJson)
    {
        try
        {
            var problem = System.Text.Json.JsonSerializer.Deserialize<ApiErrorResponse>(
                rawJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            return problem?.ErrorCode switch
            {
                "Profile.HasActiveAssignments" =>
                    "این پروفایل هنوز به یک یا چند کاربر تخصیص داده شده است. " +
                    "ابتدا آن را از لیست دسترسی‌های همه‌ی کاربران بردارید، سپس دوباره تلاش کنید.",
                "Profile.NotFound" =>
                    "این پروفایل پیدا نشد — احتمالاً قبلاً حذف شده است.",
                _ => problem?.Message ?? "خطای نامشخصی هنگام حذف پروفایل رخ داد.",
            };
        }
        catch
        {
            return "خطای نامشخصی هنگام حذف پروفایل رخ داد.";
        }
    }

    /// <summary>
    /// Matches this API's actual custom error response shape
    /// (chat, 2026-08-25 — corrected after seeing the real JSON):
    /// { errorCode, title, message, correlationId, details }.
    /// </summary>
    private sealed class ApiErrorResponse
    {
        public string? ErrorCode { get; set; }
        public string? Title { get; set; }
        public string? Message { get; set; }
    }

    private sealed class ProfileItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
        public bool IsActive { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
    }

    private sealed class SearchProfilesResponse
    {
        public List<ProfileItem> Items { get; set; } = new();
    }
}
