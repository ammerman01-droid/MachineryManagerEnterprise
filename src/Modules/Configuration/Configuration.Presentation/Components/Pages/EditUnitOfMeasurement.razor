@page "/admin/units-of-measurement/{UnitId:guid}/edit"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>ویرایش واحد اندازه‌گیری</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ویرایش واحد اندازه‌گیری</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (isLoaded)
{
    <MudPaper Class="pa-4" Style="max-width:500px;">
        <MudForm @ref="form">
            <MudTextField T="string" Label="نام واحد" @bind-Value="name" Required="true" RequiredError="نام الزامی است" MaxLength="50" />

            <MudSelect T="PhysicalQuantityKind" Label="نوع کمیت فیزیکی" @bind-Value="kind" Required="true" Class="mt-4">
                @foreach (var option in PhysicalQuantityKindNames.Ordered)
                {
                    <MudSelectItem T="PhysicalQuantityKind" Value="option">@PhysicalQuantityKindNames.GetSelectLabel(option)</MudSelectItem>
                }
            </MudSelect>

            @if (kind != originalKind)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
                    با تغییر نوع کمیت، مدل‌های دارایی یا موتوری که از این واحد استفاده می‌کنند، در ویرایش بعدی به‌دلیل
                    ناسازگاری نوع واحد خطا می‌دهند و باید واحدشان دوباره انتخاب شود.
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SubmitAsync" Disabled="isSubmitting">
                @(isSubmitting ? "در حال ذخیره..." : "ذخیره")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-4 ml-2"
                       OnClick="@(() => Navigation.NavigateTo($"/admin/units-of-measurement?holdingId={HoldingId}"))">
                انصراف
            </MudButton>
        </MudForm>
    </MudPaper>
}

@code {
    /// <summary>Gets or sets the identifier of the unit being edited, supplied via the route.</summary>
    [Parameter]
    public Guid UnitId { get; set; }

    /// <summary>Gets or sets the identifier of the Holding the unit belongs to, supplied via the query string.</summary>
    [SupplyParameterFromQuery]
    public Guid HoldingId { get; set; }

    /// <summary>Represents a Unit of Measurement in the Holding's list.</summary>
    private sealed class UnitOfMeasurementItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public PhysicalQuantityKind Kind { get; set; }
    }

    private MudForm form = null!;
    private string name = string.Empty;
    private PhysicalQuantityKind kind = PhysicalQuantityKind.Other;
    private PhysicalQuantityKind originalKind = PhysicalQuantityKind.Other;
    private bool isLoading = true;
    private bool isLoaded;
    private bool isSubmitting;
    private string? errorMessage;

    /// <summary>Loads the unit (through its Holding's unit list) so the form can be pre-filled.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (HoldingId == Guid.Empty)
            {
                errorMessage = "Holding این واحد مشخص نیست؛ از صفحه‌ی فهرست واحدها وارد شوید.";
                return;
            }

            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/units-of-measurement?holdingId={HoldingId}");
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در دریافت واحدها: {content}";
                return;
            }

            var units = JsonSerializer.Deserialize<List<UnitOfMeasurementItem>>(content, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            }) ?? [];

            var unit = units.FirstOrDefault(u => u.Id == UnitId);

            if (unit is null)
            {
                errorMessage = "واحد مورد نظر در این Holding پیدا نشد.";
                return;
            }

            name = unit.Name;
            kind = unit.Kind;
            originalKind = unit.Kind;
            isLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        await form.Validate();
        if (!form.IsValid) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PutAsJsonAsync($"/api/v1/units-of-measurement/{UnitId}", new { Name = name, Kind = kind });
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
                Navigation.NavigateTo($"/admin/units-of-measurement?holdingId={HoldingId}");
            else
                errorMessage = $"خطا در ویرایش واحد: {content}";
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
