@page "/admin/units-of-measurement"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>واحدهای اندازه‌گیری</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">مدیریت واحدهای اندازه‌گیری</MudText>

@* The selector is only needed when the user can see more than one Holding; a single one is auto-selected. *@
@if (holdings.Count > 1)
{
    <MudSelect T="Guid?" Label="انتخاب Holding" Placeholder="یک Holding را انتخاب کنید"
               @bind-Value="selectedHoldingId" @bind-Value:after="OnHoldingChangedAsync" Class="mb-4">
        @foreach (var holding in holdings)
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)holding.Id)">@holding.Name</MudSelectItem>
        }
    </MudSelect>
}

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (selectedHoldingId is not null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo($"/admin/units-of-measurement/create?holdingId={selectedHoldingId}"))">
        واحد جدید
    </MudButton>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (selectedHoldingId is not null && units.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">هیچ واحدی برای این Holding ثبت نشده است.</MudText>
}
else if (units.Count > 0)
{
    <MudTable Items="@units" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>نام</MudTh>
            <MudTh>نوع کمیت فیزیکی</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.Name</MudTd>
            <MudTd DataLabel="نوع کمیت فیزیکی">@PhysicalQuantityKindNames.GetName(context.Kind)</MudTd>
            <MudTd DataLabel="عملیات">
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="@(() => Navigation.NavigateTo($"/admin/units-of-measurement/{context.Id}/edit?holdingId={selectedHoldingId}"))">
                    ویرایش
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    /// <summary>Represents a Holding option in the selection dropdown.</summary>
    private sealed class HoldingItem
    {
        /// <summary>Gets or sets the Holding's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Holding's display name.</summary>
        public string Name { get; set; } = string.Empty;
    }

    /// <summary>Represents a Unit of Measurement option in the current Holding's list.</summary>
    private sealed class UnitOfMeasurementItem
    {
        /// <summary>Gets or sets the unit's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the unit's display name.</summary>
        public string Name { get; set; } = string.Empty;
        public PhysicalQuantityKind Kind { get; set; }
    }

    private sealed class SearchHoldingsResult
    {
        public List<HoldingItem> Items { get; set; } = [];
    }

    /// <summary>Gets or sets the Holding to pre-select, supplied via the query string (used when returning from the create/edit pages).</summary>
    [SupplyParameterFromQuery(Name = "holdingId")]
    public Guid? HoldingIdFromQuery { get; set; }

    private List<HoldingItem> holdings = [];
    private List<UnitOfMeasurementItem> units = [];
    private Guid? selectedHoldingId;
    private bool isLoading = true;
    private string? errorMessage;

    /// <summary>Loads the list of Holdings when the page is first rendered.</summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadHoldingsAsync();

        // Pre-select the Holding from the query string if it is one of the visible
        // Holdings, otherwise auto-select when only one Holding is visible.
        if (HoldingIdFromQuery is { } queryHoldingId && holdings.Any(h => h.Id == queryHoldingId))
        {
            selectedHoldingId = queryHoldingId;
        }
        else if (holdings.Count == 1)
        {
            selectedHoldingId = holdings[0].Id;
        }

        if (selectedHoldingId is not null)
        {
            await OnHoldingChangedAsync();
        }

        isLoading = false;
    }

    private async Task LoadHoldingsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/holdings?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchHoldingsResult>(content, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
                holdings = result?.Items ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت Holding ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    /// <summary>Reloads the unit list whenever the selected Holding changes.</summary>
    private async Task OnHoldingChangedAsync()
    {
        if (selectedHoldingId is null)
        {
            units = [];
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/units-of-measurement?holdingId={selectedHoldingId}");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                units = JsonSerializer.Deserialize<List<UnitOfMeasurementItem>>(content, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت واحدها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
