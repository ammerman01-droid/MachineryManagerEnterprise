@page "/admin/overflow-components/create"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>قسمت سرریز جدید</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ثبت قسمت سرریز جدید</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

<MudPaper Class="pa-4" Style="max-width:500px;">
    <MudForm @ref="form">
        <MudTextField T="string" Label="نام قسمت سرریز (مثلاً موتور، گیربکس، مخزن هیدرولیک)" @bind-Value="name" Required="true" RequiredError="نام الزامی است" MaxLength="100" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SubmitAsync" Disabled="isSubmitting">
            @(isSubmitting ? "در حال ثبت..." : "ثبت")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-4 ml-2"
                   OnClick="@(() => Navigation.NavigateTo("/admin/overflow-components"))">
            انصراف
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    [SupplyParameterFromQuery]
    public Guid HoldingId { get; set; }

    private MudForm form = null!;
    private string name = string.Empty;
    private bool isSubmitting;
    private string? errorMessage;

    private async Task SubmitAsync()
    {
        await form.Validate();
        if (!form.IsValid)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync("/api/v1/overflow-components", new { HoldingId, Name = name });
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/admin/overflow-components");
            }
            else
            {
                errorMessage = $"خطا در ثبت: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
