@page "/admin/colors"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>رنگ‌ها</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">مدیریت رنگ‌ها</MudText>

<MudSelect T="Guid?" Label="Holding" Placeholder="یک Holding را انتخاب کنید"
           @bind-Value="selectedHoldingId" @bind-Value:after="OnHoldingChangedAsync" Class="mb-4">
    @foreach (var holding in holdings)
    {
        <MudSelectItem T="Guid?" Value="@((Guid?)holding.Id)">@holding.Name</MudSelectItem>
    }
</MudSelect>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (selectedHoldingId is not null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo($"/admin/colors/create?holdingId={selectedHoldingId}"))">
        رنگ جدید
    </MudButton>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (selectedHoldingId is not null && colors.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">هیچ رنگی برای این Holding ثبت نشده است.</MudText>
}
else if (colors.Count > 0)
{
    <MudTable Items="@colors" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>نام</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.Name</MudTd>
            <MudTd DataLabel="وضعیت">
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">فعال</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">غیرفعال</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/colors/edit/{context.Id}"))" />
                @if (context.IsActive)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ToggleActiveAsync(context, deactivate: true))" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                   OnClick="@(() => ToggleActiveAsync(context, deactivate: false))" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    /// <summary>Represents a Holding option in the selection dropdown.</summary>
    private sealed class HoldingItem
    {
        /// <summary>Gets or sets the Holding's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Holding's display name.</summary>
        public string Name { get; set; } = string.Empty;
    }

    /// <summary>Represents a Color option in the current Holding's list.</summary>
    private sealed class ColorItem
    {
        /// <summary>Gets or sets the Color's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Color's display name.</summary>
        public string Name { get; set; } = string.Empty;

        /// <summary>Gets or sets whether the Color is currently active.</summary>
        public bool IsActive { get; set; } = true;
    }

    private sealed class SearchHoldingsResult
    {
        public List<HoldingItem> Items { get; set; } = [];
    }

    private List<HoldingItem> holdings = [];
    private List<ColorItem> colors = [];

    // Nullable so an unselected Holding renders as an empty placeholder
    // instead of MudSelect falling back to a raw default-value string
    // (previously Guid.Empty, shown as a run of zeros) before any
    // Holding has been chosen (chat, 2026-09-19).
    private Guid? selectedHoldingId;
    private bool isLoading = true;
    private string? errorMessage;

    /// <summary>Loads the list of Holdings when the page is first rendered.</summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadHoldingsAsync();
        isLoading = false;
    }

    private async Task LoadHoldingsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/holdings?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchHoldingsResult>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                holdings = result?.Items ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت Holding ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    /// <summary>Reloads the color list whenever the selected Holding changes.</summary>
    private async Task OnHoldingChangedAsync()
    {
        if (selectedHoldingId is null)
        {
            colors = [];
            return;
        }

        await LoadColorsAsync();
    }

    /// <summary>Retrieves the selected Holding's full color catalog, including deactivated colors, for the admin management page.</summary>
    private async Task LoadColorsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/colors?holdingId={selectedHoldingId}&includeInactive=true");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                colors = JsonSerializer.Deserialize<List<ColorItem>>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت رنگ‌ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Deactivates or reactivates the given Color, then refreshes the list.</summary>
    /// <param name="color">The Color row being toggled.</param>
    /// <param name="deactivate">
    /// <see langword="true"/> to deactivate (soft delete) the color;
    /// <see langword="false"/> to reactivate it.
    /// </param>
    private async Task ToggleActiveAsync(ColorItem color, bool deactivate)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var action = deactivate ? "deactivate" : "activate";
            var response = await client.PatchAsync($"/api/v1/colors/{color.Id}/{action}", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(deactivate ? "رنگ غیرفعال شد." : "رنگ فعال شد.", Severity.Success);
                await LoadColorsAsync();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"خطا: {content}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا: {ex.Message}", Severity.Error);
        }
    }
}
