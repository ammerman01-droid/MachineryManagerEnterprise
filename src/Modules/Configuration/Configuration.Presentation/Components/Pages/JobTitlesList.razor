@page "/admin/job-titles"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>سمت‌های شغلی</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">مدیریت سمت‌های شغلی</MudText>

<MudSelect T="Guid" Label="Holding" @bind-Value="selectedHoldingId" @bind-Value:after="OnHoldingChangedAsync" Class="mb-4">
    @foreach (var holding in holdings)
    {
        <MudSelectItem T="Guid" Value="@holding.Id">@holding.Name</MudSelectItem>
    }
</MudSelect>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (selectedHoldingId != Guid.Empty)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo($"/admin/job-titles/create?holdingId={selectedHoldingId}"))">
        سمت شغلی جدید
    </MudButton>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (selectedHoldingId != Guid.Empty && jobTitles.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">هیچ سمت شغلی برای این Holding ثبت نشده است.</MudText>
}
else if (jobTitles.Count > 0)
{
    <MudTable Items="@jobTitles" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>نام</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.Name</MudTd>
            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/job-titles/edit/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private sealed class HoldingItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class JobTitleItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class SearchHoldingsResult
    {
        public List<HoldingItem> Items { get; set; } = [];
    }

    private List<HoldingItem> holdings = [];
    private List<JobTitleItem> jobTitles = [];
    private Guid selectedHoldingId;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadHoldingsAsync();
        isLoading = false;
    }

    private async Task LoadHoldingsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/holdings?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchHoldingsResult>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                holdings = result?.Items ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت Holding ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    private async Task OnHoldingChangedAsync()
    {
        if (selectedHoldingId == Guid.Empty)
        {
            jobTitles = [];
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/job-titles?holdingId={selectedHoldingId}");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                jobTitles = JsonSerializer.Deserialize<List<JobTitleItem>>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت فهرست: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteAsync(JobTitleItem item)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "حذف",
            $"آیا از حذف \"{item.Name}\" مطمئن هستید؟",
            yesText: "حذف", cancelText: "انصراف");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.DeleteAsync($"/api/v1/job-titles/{item.Id}");

            if (response.IsSuccessStatusCode)
            {
                jobTitles.Remove(item);
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "این سمت شغلی در حال استفاده است و قابل حذف نیست."
                    : $"خطا در حذف: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }
}