@page "/admin/fuel-types"
@using MachineryManagerEnterprise.SharedKernel
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>انواع سوخت</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">مدیریت انواع سوخت</MudText>

<MudSelect T="Guid?" Label="Holding" Placeholder="یک Holding را انتخاب کنید"
           @bind-Value="selectedHoldingId" @bind-Value:after="OnHoldingChangedAsync" Class="mb-4">
    @foreach (var holding in holdings)
    {
        <MudSelectItem T="Guid?" Value="@((Guid?)holding.Id)">@holding.Name</MudSelectItem>
    }
</MudSelect>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (selectedHoldingId is not null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo($"/admin/fuel-types/create?holdingId={selectedHoldingId}"))">
        نوع سوخت جدید
    </MudButton>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (selectedHoldingId is not null && fuelTypes.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">هیچ نوع سوختی برای این Holding ثبت نشده است.</MudText>
}
else if (fuelTypes.Count > 0)
{
    <MudTable Items="@fuelTypes" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>نام</MudTh>
            <MudTh>نوع</MudTh>
            <MudTh>قیمت</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.Name</MudTd>
            <MudTd DataLabel="نوع">@TranslateKind(context.Kind)</MudTd>
            <MudTd DataLabel="قیمت">@context.Price.ToString("N0")</MudTd>
            <MudTd DataLabel="وضعیت">
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">فعال</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">غیرفعال</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/fuel-types/edit/{context.Id}"))" />
                @if (context.IsActive)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ToggleActiveAsync(context, deactivate: true))" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                   OnClick="@(() => ToggleActiveAsync(context, deactivate: false))" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    /// <summary>Represents a Holding option in the selection dropdown.</summary>
    private sealed class HoldingItem
    {
        /// <summary>Gets or sets the Holding's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Holding's display name.</summary>
        public string Name { get; set; } = string.Empty;
    }

    /// <summary>Represents a single Fuel Type row in the current Holding's list.</summary>
    private sealed class FuelTypeItem
    {
        /// <summary>Gets or sets the Fuel Type's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Fuel Type's display name.</summary>
        public string Name { get; set; } = string.Empty;

        /// <summary>Gets or sets the price.</summary>
        public long Price { get; set; }

        /// <summary>
        /// Gets or sets the fuel category. Must match the server's
        /// actual JSON representation of <c>FuelKind</c> — the enum
        /// itself, not a string (chat, 2026-09-03; System.Text.Json
        /// serializes enums as their underlying integer by default,
        /// unless a JsonStringEnumConverter is configured).
        /// </summary>
        public FuelKind Kind { get; set; }

        /// <summary>Gets or sets whether the Fuel Type is currently active.</summary>
        public bool IsActive { get; set; } = true;
    }

    private sealed class SearchHoldingsResult
    {
        public List<HoldingItem> Items { get; set; } = [];
    }

    private List<HoldingItem> holdings = [];
    private List<FuelTypeItem> fuelTypes = [];

    // Nullable so an unselected Holding renders as an empty placeholder
    // instead of MudSelect falling back to a raw default-value string
    // (previously Guid.Empty, shown as a run of zeros) before any
    // Holding has been chosen (chat, 2026-09-19).
    private Guid? selectedHoldingId;
    private bool isLoading = true;
    private string? errorMessage;

    /// <summary>Loads the list of Holdings when the page is first rendered.</summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadHoldingsAsync();
        isLoading = false;
    }

    private async Task LoadHoldingsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/holdings?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = System.Text.Json.JsonSerializer.Deserialize<SearchHoldingsResult>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                holdings = result?.Items ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت Holding ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    /// <summary>Reloads the fuel type list whenever the selected Holding changes.</summary>
    private async Task OnHoldingChangedAsync()
    {
        if (selectedHoldingId is null)
        {
            fuelTypes = [];
            return;
        }

        await LoadFuelTypesAsync();
    }

    /// <summary>Retrieves the selected Holding's full fuel type catalog, including deactivated fuel types, for the admin management page.</summary>
    private async Task LoadFuelTypesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/fuel-types?holdingId={selectedHoldingId}&includeInactive=true");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                fuelTypes = System.Text.Json.JsonSerializer.Deserialize<List<FuelTypeItem>>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت انواع سوخت: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Deactivates or reactivates the given Fuel Type, then refreshes the list.</summary>
    /// <param name="fuelType">The Fuel Type row being toggled.</param>
    /// <param name="deactivate">
    /// <see langword="true"/> to deactivate (soft delete) the fuel
    /// type; <see langword="false"/> to reactivate it.
    /// </param>
    private async Task ToggleActiveAsync(FuelTypeItem fuelType, bool deactivate)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var action = deactivate ? "deactivate" : "activate";
            var response = await client.PatchAsync($"/api/v1/fuel-types/{fuelType.Id}/{action}", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(deactivate ? "نوع سوخت غیرفعال شد." : "نوع سوخت فعال شد.", Severity.Success);
                await LoadFuelTypesAsync();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"خطا: {content}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>Translates a <see cref="FuelKind"/> value into its Persian display label.</summary>
    /// <param name="kind">The fuel category to translate.</param>
    /// <returns>The Persian display label for the given fuel category.</returns>
    private static string TranslateKind(FuelKind kind) => kind switch
    {
        FuelKind.Diesel => "گازوئیل",
        FuelKind.Gasoline => "بنزین",
        FuelKind.Gas => "گاز",
        _ => kind.ToString(),
    };
}
