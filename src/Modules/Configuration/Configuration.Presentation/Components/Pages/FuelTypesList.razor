@page "/admin/fuel-types"
@using MachineryManager.SharedKernel
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>انواع سوخت</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">مدیریت انواع سوخت</MudText>

<MudSelect T="Guid" Label="Holding" @bind-Value="selectedHoldingId" @bind-Value:after="OnHoldingChangedAsync" Class="mb-4">
    @foreach (var holding in holdings)
    {
        <MudSelectItem T="Guid" Value="@holding.Id">@holding.Name</MudSelectItem>
    }
</MudSelect>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (selectedHoldingId != Guid.Empty)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo($"/admin/fuel-types/create?holdingId={selectedHoldingId}"))">
        نوع سوخت جدید
    </MudButton>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (selectedHoldingId != Guid.Empty && fuelTypes.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">هیچ نوع سوختی برای این Holding ثبت نشده است.</MudText>
}
else if (fuelTypes.Count > 0)
{
    <MudTable Items="@fuelTypes" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>نام</MudTh>
            <MudTh>نوع</MudTh>
            <MudTh>قیمت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.Name</MudTd>
            <MudTd DataLabel="نوع">@TranslateKind(context.Kind)</MudTd>
            <MudTd DataLabel="قیمت">@context.Price.ToString("N0")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    /// <summary>Represents a Holding option in the selection dropdown.</summary>
    private sealed class HoldingItem
    {
        /// <summary>Gets or sets the Holding's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Holding's display name.</summary>
        public string Name { get; set; } = string.Empty;
    }

    /// <summary>Represents a single Fuel Type row in the current Holding's list.</summary>
    private sealed class FuelTypeItem
    {
        /// <summary>Gets or sets the Fuel Type's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Fuel Type's display name.</summary>
        public string Name { get; set; } = string.Empty;

        /// <summary>Gets or sets the price.</summary>
        public long Price { get; set; }

        /// <summary>
        /// Gets or sets the fuel category. Must match the server's
        /// actual JSON representation of <c>FuelKind</c> — the enum
        /// itself, not a string (chat, 2026-09-03; System.Text.Json
        /// serializes enums as their underlying integer by default,
        /// unless a JsonStringEnumConverter is configured).
        /// </summary>
        public FuelKind Kind { get; set; }
    }

    private sealed class SearchHoldingsResult
    {
        public List<HoldingItem> Items { get; set; } = [];
    }

    private List<HoldingItem> holdings = [];
    private List<FuelTypeItem> fuelTypes = [];
    private Guid selectedHoldingId;
    private bool isLoading = true;
    private string? errorMessage;

    /// <summary>Loads the list of Holdings when the page is first rendered.</summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadHoldingsAsync();
        isLoading = false;
    }

    private async Task LoadHoldingsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/holdings?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = System.Text.Json.JsonSerializer.Deserialize<SearchHoldingsResult>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                holdings = result?.Items ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت Holding ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    /// <summary>Reloads the fuel type list whenever the selected Holding changes.</summary>
    private async Task OnHoldingChangedAsync()
    {
        if (selectedHoldingId == Guid.Empty)
        {
            fuelTypes = [];
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/fuel-types?holdingId={selectedHoldingId}");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                fuelTypes = System.Text.Json.JsonSerializer.Deserialize<List<FuelTypeItem>>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت انواع سوخت: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Translates a <see cref="FuelKind"/> value into its Persian display label.</summary>
    /// <param name="kind">The fuel category to translate.</param>
    /// <returns>The Persian display label for the given fuel category.</returns>
    private static string TranslateKind(FuelKind kind) => kind switch
    {
        FuelKind.Diesel => "گازوئیل",
        FuelKind.Gasoline => "بنزین",
        FuelKind.Gas => "گاز",
        _ => kind.ToString(),
    };
}