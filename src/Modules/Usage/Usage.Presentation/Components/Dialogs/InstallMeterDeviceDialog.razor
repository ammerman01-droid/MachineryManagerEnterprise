@using System.Text.Json
@using MachineryManagerEnterprise.Usage.Presentation.Components
@inject IHttpClientFactory HttpClientFactory

<MudDialog>
    <TitleContent>نصب دستگاه روی یک مالک</TitleContent>
    <DialogContent>
        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(DeviceName))
        {
            <MudText Typo="Typo.body2" Class="mb-4">دستگاه: <b>@DeviceName</b></MudText>
        }

        <MudSelect T="string" @bind-Value="ownerType" Label="نوع مالک" Placeholder="نوع مالک را انتخاب کنید" Class="mb-4">
            <MudSelectItem T="string" Value="@("Asset")">دارایی</MudSelectItem>
            <MudSelectItem T="string" Value="@("Component")" Disabled="true">
                قطعهٔ ردیابی‌شونده (هنوز پشتیبانی نمی‌شود)
            </MudSelectItem>
        </MudSelect>

        @if (ownerType == "Asset")
        {
            @if (isLoadingAssets)
            {
                <MudProgressLinear Indeterminate="true" Class="my-2" />
            }
            else
            {
                <MudSelect T="Guid?" @bind-Value="ownerId" Label="دارایی" Placeholder="یک دارایی را انتخاب کنید"
                           HelperText="هر دارایی می‌تواند دستگاه‌هایی از حداکثر دو نوع مختلف (مثلاً ساعت‌شمار و کیلومترشمار) داشته باشد.">
                    @foreach (var asset in assets)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)asset.Id)">@asset.Name (@asset.Code)</MudSelectItem>
                    }
                </MudSelect>

                @if (assets.Count == 0 && loadError is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-2">
                        هیچ دارایی‌ای برای این سازمان پیدا نشد.
                    </MudText>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="isSubmitting">
            نصب
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>The device to install.</summary>
    [Parameter]
    public Guid MeterDeviceId { get; set; }

    /// <summary>The name of the device to install, shown for orientation.</summary>
    [Parameter]
    public string? DeviceName { get; set; }

    /// <summary>The Organization to look up candidate Assets in.</summary>
    [Parameter]
    public Guid OrganizationId { get; set; }

    private sealed class AssetItem
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private sealed class SearchAssetsResult
    {
        public List<AssetItem> Items { get; set; } = [];
    }

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private List<AssetItem> assets = [];
    private bool isLoadingAssets;
    private bool isSubmitting;

    // Only Assets can own a device today, so the owner type is pre-selected and the Asset
    // list is loaded as soon as the dialog opens. (Loading it from OnParametersSetAsync, as
    // before, never fired when the user picked the type afterwards, leaving the picker empty.)
    private string? ownerType = "Asset";
    private Guid? ownerId;
    private string? errorMessage;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssetsAsync();
    }

    private async Task LoadAssetsAsync()
    {
        isLoadingAssets = true;
        loadError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/assets?organizationId={OrganizationId}&page=1&pageSize=200");

            if (response.IsSuccessStatusCode)
            {
                var stream = await response.Content.ReadAsStreamAsync();
                var result = await JsonSerializer.DeserializeAsync<SearchAssetsResult>(stream, JsonOptions);
                assets = (result?.Items ?? []).OrderBy(a => a.Code).ToList();
            }
            else
            {
                loadError = await UsageProblemMessages.DescribeAsync(response, "خطا در دریافت فهرست دارایی‌ها");
                errorMessage = loadError;
            }
        }
        catch (Exception ex)
        {
            loadError = $"خطا در دریافت فهرست دارایی‌ها: {ex.Message}";
            errorMessage = loadError;
        }
        finally
        {
            isLoadingAssets = false;
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (ownerType is null || ownerId is null)
        {
            errorMessage = "لطفاً نوع مالک و خود مالک را انتخاب کنید.";
            return;
        }

        isSubmitting = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync(
                $"/api/v1/meter-devices/{MeterDeviceId}/install",
                new { OwnerType = ownerType, OwnerId = ownerId.Value });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در نصب دستگاه");
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در نصب دستگاه: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
