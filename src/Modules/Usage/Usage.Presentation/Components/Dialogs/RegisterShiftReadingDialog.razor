@using System.Text.Json
@using MachineryManagerEnterprise.UI.Components
@using MachineryManagerEnterprise.UI.Calendar
@using MachineryManagerEnterprise.Usage.Presentation.Components
@inject IHttpClientFactory HttpClientFactory

<MudDialog>
    <TitleContent>ثبت کارکرد شیفت</TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <MudText Typo="Typo.subtitle2" Color="Color.Primary">۱. دستگاه و زمان</MudText>

            @if (MeterDeviceId is null)
            {
                @if (isDevicesLoading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <MudAutocomplete T="DeviceOption"
                                     @bind-Value="selectedDevice"
                                     @bind-Value:after="OnDeviceChangedAsync"
                                     Label="دستگاه (جستجو بر اساس کد یا نام)"
                                     Required="true"
                                     SearchFunc="@SearchDevicesAsync"
                                     ToStringFunc="@(device => device is null ? string.Empty : DeviceLabel(device))"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     OpenOnFocus="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true" />
                }
            }

            @if (ResolvedDeviceId is not null)
            {
                <JalaliDatePicker Date="entryDate" DateChanged="OnEntryDateChangedAsync" Label="تاریخ" Required="true" />

                @if (isScheduleLoading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (entryDate is not null && shifts.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning">
                        برای این تاریخ شیفتی در تقویم کاری یافت نشد.
                    </MudAlert>
                }
                else if (shifts.Count > 1)
                {
                    <MudSelect T="int?" @bind-Value="selectedShiftIndex" @bind-Value:after="OnShiftIndexChanged"
                               Label="شیفت" Required="true">
                        @foreach (var shift in shifts)
                        {
                            <MudSelectItem T="int?" Value="@((int?)shift.Index)">
                                شیفت @(shift.Index + 1) — @shift.StartTime.ToString("HH:mm") تا @shift.EndTime.ToString("HH:mm")
                            </MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (shifts.Count == 1)
                {
                    <MudTextField T="string" ReadOnly="true" Label="شیفت" Value="@SingleShiftText" />
                }

                @if (selectedShiftIndex is not null)
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudTimePicker Label="ساعت شروع شیفت" @bind-Time="shiftStartTime" Required="true"
                                           AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker Label="ساعت پایان شیفت" @bind-Time="shiftEndTime" Required="true"
                                           AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        ساعت‌ها از تقویم کاری پر شده‌اند و در صورت نیاز قابل تغییرند.
                    </MudText>
                }

                <MudDivider />

                <MudText Typo="Typo.subtitle2" Color="Color.Primary">۲. قرائت کنتور</MudText>

                @if (SourceDeviceDiffers)
                {
                    <MudAlert Severity="Severity.Warning">
                        آخرین قرائت ثبت‌شده برای این دارایی با دستگاه دیگری انجام شده است. اگر کنتور تعویض شده، ابتدا از «بازتنظیم شمارنده» استفاده کنید.
                    </MudAlert>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" ReadOnly="true" Label="آخرین قرائت قبلی" Value="@LastReadingText" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal?" @bind-Value="rawReadingValue" Immediate="true" HideSpinButtons="true"
                                         Label="قرائت فعلی کنتور" Required="true" Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" ReadOnly="true" Label="کارکرد مولد" Value="@UsageText" Error="@(UsageDelta is < 0)" />
                    </MudItem>
                </MudGrid>

                @if (!string.IsNullOrEmpty(LastReadingCaption))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">آخرین ثبت: @LastReadingCaption</MudText>
                }

                @if (UsageDelta is < 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">قرائت فعلی از قرائت قبلی کمتر است و ثبت نمی‌شود.</MudText>
                }

                <MudDivider />

                <MudText Typo="Typo.subtitle2" Color="Color.Primary">۳. اپراتور</MudText>

                @if (personnelError is not null)
                {
                    <MudAlert Severity="Severity.Warning">@personnelError</MudAlert>
                }

                @if (isPersonnelLoading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <MudAutocomplete T="PersonnelOption"
                                     @bind-Value="selectedOperator"
                                     Label="اپراتور (اختیاری؛ جستجو بر اساس نام یا کد پرسنلی)"
                                     SearchFunc="@SearchPersonnelAsync"
                                     ToStringFunc="@(person => person is null ? string.Empty : PersonLabel(person))"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     OpenOnFocus="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true"
                                     HelperText="@(personnel.Count == 0 ? "برای این سازمان پرسنلی ثبت نشده است." : null)" />
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="@(isSubmitting || ResolvedDeviceId is null || selectedShiftIndex is null || rawReadingValue is null)">
            ثبت کارکرد
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The device this shift's reading is being registered for, when already known (e.g. opened from
    /// <c>MeterDeviceDetails</c>). When <see langword="null"/>, <see cref="OrganizationId"/> must be
    /// supplied instead and the dialog shows a searchable device picker first (chat, 2026-10-04 —
    /// opened from the org-wide usage list page).
    /// </summary>
    [Parameter]
    public Guid? MeterDeviceId { get; set; }

    /// <summary>The Organization to list devices and personnel from, when <see cref="MeterDeviceId"/> is not already known.</summary>
    [Parameter]
    public Guid? OrganizationId { get; set; }

    private Guid? ResolvedDeviceId => MeterDeviceId ?? selectedDevice?.Id;

    private sealed record DeviceOption(Guid Id, string? Unit, string? OwnerType, Guid? OwnerId, string? OwnerCode, string? OwnerName);

    private sealed record PersonnelOption(Guid Id, string FirstName, string LastName, string PersonnelCode);

    private sealed record ShiftOption(int Index, TimeOnly StartTime, TimeOnly EndTime);

    private sealed class DeviceHeader
    {
        public Guid OrganizationId { get; set; }
    }

    private sealed class DayScheduleResult
    {
        public bool IsWorkingDay { get; set; }
        public List<ShiftOption> Shifts { get; set; } = [];
    }

    private sealed class LastReadingInfo
    {
        public string? Unit { get; set; }
        public decimal? RawReadingValue { get; set; }
        public DateOnly? EntryDate { get; set; }
        public int? ShiftIndex { get; set; }
        public Guid? SourceMeterDeviceId { get; set; }
    }

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private List<DeviceOption> devices = [];
    private List<PersonnelOption> personnel = [];
    private DeviceOption? selectedDevice;
    private PersonnelOption? selectedOperator;
    private LastReadingInfo? lastReading;
    private DateTime? entryDate = DateTime.Today;
    private List<ShiftOption> shifts = [];
    private int? selectedShiftIndex;
    private TimeSpan? shiftStartTime;
    private TimeSpan? shiftEndTime;
    private decimal? rawReadingValue;
    private bool isDevicesLoading;
    private bool isPersonnelLoading;
    private bool isScheduleLoading;
    private bool isLastReadingLoading;
    private bool isSubmitting;
    private string? errorMessage;
    private string? personnelError;

    /// <summary>
    /// The usage this reading would add — the difference to the previous reading. This is only a
    /// preview: the server recomputes it when saving and remains the authority (gap-filled shifts,
    /// device changes and so on are handled there).
    /// </summary>
    private decimal? UsageDelta =>
        rawReadingValue is { } current && lastReading?.RawReadingValue is { } previous
            ? current - previous
            : null;

    private string SingleShiftText =>
        shifts.Count == 1
            ? $"شیفت {shifts[0].Index + 1} — {shifts[0].StartTime:HH:mm} تا {shifts[0].EndTime:HH:mm} (تنها شیفت این روز)"
            : string.Empty;

    private string LastReadingText =>
        isLastReadingLoading
            ? "..."
            : lastReading?.RawReadingValue is { } previous
                ? $"{previous:0.####} {UsageDisplayNames.GetUnitName(lastReading.Unit)}"
                : "ثبت نشده";

    private string UsageText =>
        UsageDelta is { } delta
            ? $"{delta:0.####} {UsageDisplayNames.GetUnitName(lastReading?.Unit)}"
            : rawReadingValue is not null && lastReading is { RawReadingValue: null }
                ? "0 (اولین ثبت)"
                : "—";

    private bool SourceDeviceDiffers =>
        lastReading?.SourceMeterDeviceId is { } source && ResolvedDeviceId is { } current && source != current;

    private string LastReadingCaption
    {
        get
        {
            if (lastReading?.EntryDate is not { } date)
            {
                return string.Empty;
            }

            var jalali = JalaliCalendarConverter.Format(date.ToDateTime(TimeOnly.MinValue));

            return lastReading.ShiftIndex is { } shift
                ? $"{jalali} — شیفت {shift + 1}"
                : $"{jalali} — بازتنظیم شمارنده";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (MeterDeviceId is not null)
        {
            await Task.WhenAll(LoadScheduleAsync(), LoadLastReadingAsync(), LoadPersonnelForDeviceAsync());
            return;
        }

        if (OrganizationId is null)
        {
            errorMessage = "دستگاه یا سازمان مشخص نشده است.";
            return;
        }

        await Task.WhenAll(LoadDevicesAsync(), LoadPersonnelAsync(OrganizationId.Value));
    }

    private static string DeviceLabel(DeviceOption device) =>
        $"{device.OwnerCode ?? "—"} — {device.OwnerName ?? "دارایی نامشخص"} ({UsageDisplayNames.GetUnitName(device.Unit)})";

    private static string PersonLabel(PersonnelOption person) =>
        $"{person.FirstName} {person.LastName} ({person.PersonnelCode})";

    private static bool ContainsTerm(string? text, string term) =>
        text?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

    private Task<IEnumerable<DeviceOption>> SearchDevicesAsync(string? value, CancellationToken cancellationToken)
    {
        var term = value?.Trim();

        IEnumerable<DeviceOption> matches = string.IsNullOrEmpty(term)
            ? devices
            : devices.Where(d => ContainsTerm(d.OwnerCode, term) || ContainsTerm(d.OwnerName, term));

        return Task.FromResult(matches);
    }

    private Task<IEnumerable<PersonnelOption>> SearchPersonnelAsync(string? value, CancellationToken cancellationToken)
    {
        var term = value?.Trim();

        IEnumerable<PersonnelOption> matches = string.IsNullOrEmpty(term)
            ? personnel
            : personnel.Where(p =>
                ContainsTerm(p.FirstName, term)
                || ContainsTerm(p.LastName, term)
                || ContainsTerm(p.PersonnelCode, term)
                || ContainsTerm($"{p.FirstName} {p.LastName}", term));

        return Task.FromResult(matches);
    }

    private async Task LoadDevicesAsync()
    {
        isDevicesLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/meter-devices?organizationId={OrganizationId}&page=1&pageSize=200");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در دریافت فهرست دستگاه‌ها");
                return;
            }

            using var document = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            devices = ReadItems<DeviceOption>(document.RootElement).Where(d => d.OwnerId is not null).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در دریافت فهرست دستگاه‌ها: {ex.Message}";
        }
        finally
        {
            isDevicesLoading = false;
        }
    }

    /// <summary>
    /// When opened for a known device (no <see cref="OrganizationId"/> supplied), reads the device
    /// first to learn which Organization's personnel to list.
    /// </summary>
    private async Task LoadPersonnelForDeviceAsync()
    {
        if (OrganizationId is { } organizationId)
        {
            await LoadPersonnelAsync(organizationId);
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/meter-devices/{MeterDeviceId}");

            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var header = await JsonSerializer.DeserializeAsync<DeviceHeader>(await response.Content.ReadAsStreamAsync(), JsonOptions);

            if (header is not null && header.OrganizationId != Guid.Empty)
            {
                await LoadPersonnelAsync(header.OrganizationId);
            }
        }
        catch (Exception ex)
        {
            personnelError = $"خطا در دریافت فهرست پرسنل: {ex.Message}";
        }
    }

    private async Task LoadPersonnelAsync(Guid organizationId)
    {
        isPersonnelLoading = true;
        personnelError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/personnel?organizationId={organizationId}");

            if (!response.IsSuccessStatusCode)
            {
                personnelError = await UsageProblemMessages.DescribeAsync(response, "خطا در دریافت فهرست پرسنل");
                return;
            }

            using var document = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            personnel = ReadItems<PersonnelOption>(document.RootElement)
                .OrderBy(p => p.LastName)
                .ThenBy(p => p.FirstName)
                .ToList();
        }
        catch (Exception ex)
        {
            personnelError = $"خطا در دریافت فهرست پرسنل: {ex.Message}";
        }
        finally
        {
            isPersonnelLoading = false;
        }
    }

    /// <summary>
    /// Reads a list from a bare JSON array, or from an object that wraps one — the API's list
    /// endpoints name that wrapper property differently, so the first array-valued property wins.
    /// </summary>
    private static List<T> ReadItems<T>(JsonElement root)
    {
        var array = root;

        if (root.ValueKind == JsonValueKind.Object)
        {
            array = default;

            foreach (var property in root.EnumerateObject())
            {
                if (property.Value.ValueKind == JsonValueKind.Array)
                {
                    array = property.Value;
                    break;
                }
            }
        }

        return array.ValueKind == JsonValueKind.Array
            ? array.Deserialize<List<T>>(JsonOptions) ?? []
            : [];
    }

    private async Task OnDeviceChangedAsync()
    {
        selectedShiftIndex = null;
        shifts = [];
        lastReading = null;

        if (selectedDevice is not null)
        {
            await Task.WhenAll(LoadScheduleAsync(), LoadLastReadingAsync());
        }
    }

    private async Task OnEntryDateChangedAsync(DateTime? date)
    {
        entryDate = date;
        selectedShiftIndex = null;
        shiftStartTime = null;
        shiftEndTime = null;
        await LoadScheduleAsync();
    }

    private async Task LoadScheduleAsync()
    {
        shifts = [];

        if (entryDate is null || ResolvedDeviceId is null)
        {
            return;
        }

        isScheduleLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var date = DateOnly.FromDateTime(entryDate.Value);
            var response = await client.GetAsync($"/api/v1/meter-devices/{ResolvedDeviceId}/day-schedule?date={date:yyyy-MM-dd}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در دریافت شیفت‌های این روز");
                return;
            }

            var stream = await response.Content.ReadAsStreamAsync();
            var result = await JsonSerializer.DeserializeAsync<DayScheduleResult>(stream, JsonOptions);
            shifts = result?.Shifts ?? [];

            // Only one shift exists for the day: select it automatically so the user doesn't have
            // to make a trivial choice (chat, 2026-10-03). With more than one, the user must pick.
            if (shifts.Count == 1)
            {
                ApplySelectedShift(shifts[0]);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در دریافت شیفت‌های این روز: {ex.Message}";
        }
        finally
        {
            isScheduleLoading = false;
        }
    }

    /// <summary>Loads the previous reading shown next to the input and used for the usage preview.</summary>
    private async Task LoadLastReadingAsync()
    {
        if (ResolvedDeviceId is null)
        {
            return;
        }

        isLastReadingLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/meter-devices/{ResolvedDeviceId}/last-reading");

            if (response.IsSuccessStatusCode)
            {
                lastReading = await JsonSerializer.DeserializeAsync<LastReadingInfo>(
                    await response.Content.ReadAsStreamAsync(), JsonOptions);
            }
        }
        catch
        {
            // The preview is a convenience; the save itself still validates everything server-side.
        }
        finally
        {
            isLastReadingLoading = false;
        }
    }

    private void OnShiftIndexChanged()
    {
        var shift = shifts.FirstOrDefault(s => s.Index == selectedShiftIndex);

        if (shift is not null)
        {
            ApplySelectedShift(shift);
        }
    }

    private void ApplySelectedShift(ShiftOption shift)
    {
        selectedShiftIndex = shift.Index;
        // Prefill from the Work Calendar's scheduled time; the user may still edit these freely
        // before submitting (chat, 2026-10-03) — they are not re-validated against the calendar.
        shiftStartTime = shift.StartTime.ToTimeSpan();
        shiftEndTime = shift.EndTime.ToTimeSpan();
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (entryDate is null || ResolvedDeviceId is null || selectedShiftIndex is null || rawReadingValue is null)
        {
            errorMessage = "لطفاً دستگاه، تاریخ، شیفت و مقدار خوانده‌شده از کنتور را وارد کنید.";
            return;
        }

        if (shiftStartTime is null || shiftEndTime is null || shiftStartTime == shiftEndTime)
        {
            errorMessage = "ساعت شروع و پایان شیفت را به‌درستی انتخاب کنید (این دو نباید یکسان باشند).";
            return;
        }

        isSubmitting = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync(
                $"/api/v1/meter-devices/{ResolvedDeviceId}/shift-reading",
                new
                {
                    EntryDate = DateOnly.FromDateTime(entryDate.Value),
                    ShiftIndex = selectedShiftIndex.Value,
                    RawReadingValue = rawReadingValue.Value,
                    OperatorId = selectedOperator?.Id,
                    ShiftStartTime = TimeOnly.FromTimeSpan(shiftStartTime.Value),
                    ShiftEndTime = TimeOnly.FromTimeSpan(shiftEndTime.Value),
                });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در ثبت کارکرد");
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در ثبت کارکرد: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
