@using System.Text.Json
@using MachineryManagerEnterprise.UI.Components
@using MachineryManagerEnterprise.Usage.Presentation.Components
@inject IHttpClientFactory HttpClientFactory

<MudDialog>
    <TitleContent>اصلاح مشخصات شیفت</TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <MudField Label="تاریخ / شیفت">@EntryDate.ToString("yyyy-MM-dd") — شیفت @(ShiftIndex + 1)</MudField>

            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTimePicker Label="ساعت شروع شیفت" @bind-Time="shiftStartTime" Required="true"
                                   AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker Label="ساعت پایان شیفت" @bind-Time="shiftEndTime" Required="true"
                                   AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter" />
                </MudItem>
            </MudGrid>

            @if (OrganizationId is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">اپراتور فعلی بدون تغییر می‌ماند.</MudText>
            }
            else if (isPersonnelLoading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else
            {
                <MudAutocomplete T="PersonnelOption"
                                 @bind-Value="selectedOperator"
                                 Label="اپراتور (جستجو بر اساس نام یا کد پرسنلی)"
                                 SearchFunc="@SearchPersonnelAsync"
                                 ToStringFunc="@(person => person is null ? string.Empty : PersonLabel(person))"
                                 MinCharacters="0"
                                 MaxItems="50"
                                 OpenOnFocus="true"
                                 ResetValueOnEmptyText="true"
                                 Clearable="true" />
            }

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                این اصلاح کارکرد مولد ثبت‌شده را تغییر نمی‌دهد؛ فقط مشخصات نمایشی شیفت را عوض می‌کند.
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="isSubmitting">
            ثبت اصلاحیه
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>The kind of owner the ledger this entry belongs to.</summary>
    [Parameter]
    public string OwnerType { get; set; } = string.Empty;

    /// <summary>The identifier of the ledger's owner.</summary>
    [Parameter]
    public Guid OwnerId { get; set; }

    /// <summary>The unit of the ledger this entry belongs to.</summary>
    [Parameter]
    public string Unit { get; set; } = string.Empty;

    /// <summary>The date of the shift reading being corrected.</summary>
    [Parameter]
    public DateOnly EntryDate { get; set; }

    /// <summary>The shift index of the reading being corrected.</summary>
    [Parameter]
    public int ShiftIndex { get; set; }

    /// <summary>The entry's operator attribution before correction, used to preselect the operator.</summary>
    [Parameter]
    public Guid? CurrentOperatorId { get; set; }

    /// <summary>The entry's shift start time before correction, used to prefill the picker.</summary>
    [Parameter]
    public TimeOnly CurrentShiftStartTime { get; set; }

    /// <summary>The entry's shift end time before correction, used to prefill the picker.</summary>
    [Parameter]
    public TimeOnly CurrentShiftEndTime { get; set; }

    /// <summary>
    /// The Organization whose personnel may be picked as operator. When <see langword="null"/> the
    /// operator picker is hidden and the entry's current operator is kept unchanged.
    /// </summary>
    [Parameter]
    public Guid? OrganizationId { get; set; }

    private sealed record PersonnelOption(Guid Id, string FirstName, string LastName, string PersonnelCode);

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private List<PersonnelOption> personnel = [];
    private PersonnelOption? selectedOperator;
    private TimeSpan? shiftStartTime;
    private TimeSpan? shiftEndTime;
    private bool isPersonnelLoading;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        shiftStartTime = CurrentShiftStartTime.ToTimeSpan();
        shiftEndTime = CurrentShiftEndTime.ToTimeSpan();

        if (OrganizationId is { } organizationId)
        {
            await LoadPersonnelAsync(organizationId);
        }
    }

    private static string PersonLabel(PersonnelOption person) =>
        $"{person.FirstName} {person.LastName} ({person.PersonnelCode})";

    private static bool ContainsTerm(string? text, string term) =>
        text?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

    private Task<IEnumerable<PersonnelOption>> SearchPersonnelAsync(string? value, CancellationToken cancellationToken)
    {
        var term = value?.Trim();

        IEnumerable<PersonnelOption> matches = string.IsNullOrEmpty(term)
            ? personnel
            : personnel.Where(p =>
                ContainsTerm(p.FirstName, term)
                || ContainsTerm(p.LastName, term)
                || ContainsTerm(p.PersonnelCode, term)
                || ContainsTerm($"{p.FirstName} {p.LastName}", term));

        return Task.FromResult(matches);
    }

    private async Task LoadPersonnelAsync(Guid organizationId)
    {
        isPersonnelLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/personnel?organizationId={organizationId}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در دریافت فهرست پرسنل");
                return;
            }

            using var document = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            var root = document.RootElement;
            var array = root;

            if (root.ValueKind == JsonValueKind.Object)
            {
                array = default;

                foreach (var property in root.EnumerateObject())
                {
                    if (property.Value.ValueKind == JsonValueKind.Array)
                    {
                        array = property.Value;
                        break;
                    }
                }
            }

            personnel = array.ValueKind == JsonValueKind.Array
                ? (array.Deserialize<List<PersonnelOption>>(JsonOptions) ?? [])
                    .OrderBy(p => p.LastName)
                    .ThenBy(p => p.FirstName)
                    .ToList()
                : [];

            selectedOperator = personnel.FirstOrDefault(p => p.Id == CurrentOperatorId);
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در دریافت فهرست پرسنل: {ex.Message}";
        }
        finally
        {
            isPersonnelLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (shiftStartTime is null || shiftEndTime is null || shiftStartTime == shiftEndTime)
        {
            errorMessage = "ساعت شروع و پایان شیفت را به‌درستی انتخاب کنید (این دو نباید یکسان باشند).";
            return;
        }

        // Without an Organization the operator picker is hidden, so the current operator is kept.
        var operatorId = OrganizationId is null ? CurrentOperatorId : selectedOperator?.Id;

        isSubmitting = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PutAsJsonAsync(
                $"/api/v1/usage-ledgers/{OwnerType}/{OwnerId}/{Unit}/daily-usage/{EntryDate:yyyy-MM-dd}/{ShiftIndex}/details",
                new
                {
                    OperatorId = operatorId,
                    ShiftStartTime = TimeOnly.FromTimeSpan(shiftStartTime.Value),
                    ShiftEndTime = TimeOnly.FromTimeSpan(shiftEndTime.Value),
                });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در اصلاح مشخصات");
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در اصلاح مشخصات: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
