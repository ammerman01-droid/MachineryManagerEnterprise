@page "/admin/meter-devices/{OrganizationId:guid}/create"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@using System.Text.Json
@using MachineryManagerEnterprise.Usage.Presentation.Components

<PageTitle>ثبت دستگاه شمارشگر</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ثبت دستگاه شمارشگر جدید</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

<MudPaper Class="pa-4">
    <MudForm @ref="form" Model="@this">
        <MudTextField T="string" @bind-Value="name" Label="نام دستگاه" Required="true" RequiredError="نام دستگاه الزامی است"
                      MaxLength="100" Immediate="true" Class="mb-4"
                      HelperText="نامی قابل‌فهم برای کاربر؛ باید در سطح سازمان یکتا باشد (بعداً قابل ویرایش است)." />

        <MudSelect T="string" @bind-Value="unit" Label="واحد کنتر" Required="true" RequiredError="واحد کنتر الزامی است" Class="mb-4"
                   HelperText="این واحد برای تمام عمر دستگاه ثابت می‌ماند و بعداً قابل تغییر نیست.">
            @foreach (var unitOption in unitOptions)
            {
                <MudSelectItem T="string" Value="@unitOption">@UsageDisplayNames.GetUnitName(unitOption)</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="decimal?" @bind-Value="dailyCapOverride" Label="سقف روزانه اختصاصی (اختیاری)"
                          Placeholder="در صورت خالی‌گذاشتن، سقف پیش‌فرض سامانه اعمال می‌شود"
                          HelperText="مقدار حداکثر کارکرد مولد روزانهٔ این دستگاه (بر حسب واحد اندازه‌گیری‌اش)، فقط اگر بخواهید با سقف کلی سازمان متفاوت باشد."
                          Min="0" Class="mb-4" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync"
                   Disabled="@(isSubmitting || string.IsNullOrEmpty(unit) || string.IsNullOrWhiteSpace(name))">
            ثبت دستگاه
        </MudButton>
        <MudButton Variant="Variant.Text" Class="mr-2" OnClick="GoBackToList">
            انصراف
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    /// <summary>The Organization the new device will belong to.</summary>
    [Parameter]
    public Guid OrganizationId { get; set; }

    /// <summary>The Holding the user was working in, carried along so the list page can be restored afterwards.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "holdingId")]
    public Guid? HoldingId { get; set; }

    private sealed class RegisterMeterDeviceRequest
    {
        public Guid OrganizationId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public decimal? DailyCapOverride { get; set; }
    }

    private sealed class RegisterMeterDeviceResult
    {
        public Guid Id { get; set; }
    }

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    private static readonly string[] unitOptions = ["Hour", "Kilometer", "Mile"];

    private MudForm form = null!;
    private string? name;
    private string? unit;
    private decimal? dailyCapOverride;
    private bool isSubmitting;
    private string? errorMessage;

    private string GetListUrl() =>
        HoldingId is { } holdingId
            ? $"/admin/meter-devices?holdingId={holdingId}&organizationId={OrganizationId}"
            : "/admin/meter-devices";

    private void GoBackToList() => Navigation.NavigateTo(GetListUrl());

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(name))
        {
            errorMessage = "لطفاً نام دستگاه را وارد کنید.";
            return;
        }

        if (string.IsNullOrEmpty(unit))
        {
            errorMessage = "لطفاً واحد کنتر را انتخاب کنید.";
            return;
        }

        isSubmitting = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync(
                "/api/v1/meter-devices",
                new RegisterMeterDeviceRequest
                {
                    OrganizationId = OrganizationId,
                    Name = name.Trim(),
                    Unit = unit,
                    DailyCapOverride = dailyCapOverride,
                });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در ثبت دستگاه");
                return;
            }

            var stream = await response.Content.ReadAsStreamAsync();
            var result = await JsonSerializer.DeserializeAsync<RegisterMeterDeviceResult>(stream, JsonOptions);

            if (result is not null)
            {
                var query = HoldingId is { } holdingId ? $"?holdingId={holdingId}" : string.Empty;
                Navigation.NavigateTo($"/admin/meter-devices/details/{result.Id}{query}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در ثبت دستگاه: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
