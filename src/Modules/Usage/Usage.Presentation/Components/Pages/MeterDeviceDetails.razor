@page "/admin/meter-devices/details/{MeterDeviceId:guid}"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IDialogService DialogService
@using System.Text.Json
@using MachineryManagerEnterprise.UI.Components
@using MachineryManagerEnterprise.UI.Calendar
@using MachineryManagerEnterprise.Usage.Presentation.Components
@using MachineryManagerEnterprise.Usage.Presentation.Components.Dialogs

<PageTitle>جزئیات دستگاه شمارشگر</PageTitle>

<MudButton Variant="Variant.Text" Color="Color.Primary" Class="mb-2"
           StartIcon="@Icons.Material.Filled.ArrowForward" OnClick="GoBackToList">
    بازگشت به فهرست دستگاه‌ها
</MudButton>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (device is not null)
{
    <MudText Typo="Typo.h4" Class="mb-4">دستگاه شمارشگر: @device.Name</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudField Label="نام دستگاه" Style="min-height: 60px;">@device.Name</MudField>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudField Label="واحد اندازه‌گیری" Style="min-height: 60px;">@UsageDisplayNames.GetUnitName(device.Unit)</MudField>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudField Label="وضعیت" Style="min-height: 60px;">
                    <div class="d-flex align-center" style="height: 24px;">
                        <MudChip T="string" Color="MeterDeviceStatusDisplay.GetColor(device.Status)" Size="Size.Small" Class="ma-0">
                            @MeterDeviceStatusDisplay.GetName(device.Status)
                        </MudChip>
                    </div>
                </MudField>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudField Label="سقف روزانه اختصاصی" Style="min-height: 60px;">@(device.DailyCapOverride?.ToString("0.##") ?? "پیش‌فرض سامانه")</MudField>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudField Label="نوع مالک" Style="min-height: 60px;">@(device.OwnerType is null ? "—" : UsageDisplayNames.GetOwnerTypeName(device.OwnerType))</MudField>
            </MudItem>
            <MudItem xs="12" sm="9">
                <MudField Label="مالک فعلی" Style="min-height: 60px;">@GetOwnerText()</MudField>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">عملیات</MudText>
        <div class="d-flex flex-wrap" style="gap: 8px;">
            @if (device.Status == "Registered")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenInstallDialogAsync">
                    نصب روی یک مالک
                </MudButton>
            }

            @if (device.Status is "Installed" or "Operational")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRegisterShiftReadingDialogAsync">
                    ثبت کارکرد شیفت
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="OpenRebaseDialogAsync">
                    بازتنظیم شمارنده
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="OpenDeleteLatestDialogAsync">
                    حذف آخرین ردیف
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ReportFailureAsync">
                    اعلام خرابی
                </MudButton>
            }

            @if (device.Status == "Failed")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="RecoverAsync">
                    بازیابی از خرابی
                </MudButton>
            }

            @if (device.Status is "Installed" or "Operational" or "Failed")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RemoveAsync">
                    جدا کردن از مالک فعلی
                </MudButton>
            }

            @if (device.Status == "Removed")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Dark" OnClick="ArchiveAsync">
                    بایگانی نهایی
                </MudButton>
            }

            @if (device.Status != "Archived")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditNameDialogAsync">
                    ویرایش نام
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Speed" OnClick="OpenEditDailyCapDialogAsync">
                    ویرایش سقف روزانه
                </MudButton>
            }
        </div>
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">تاریخچهٔ کارکرد</MudText>

        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4" Class="d-flex align-center" style="gap: 4px;">
                <JalaliDatePicker Date="fromDate" DateChanged="@((DateTime? d) => fromDate = d)" Label="از تاریخ" />
                <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="@(() => fromDate = null)" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center" style="gap: 4px;">
                <JalaliDatePicker Date="toDate" DateChanged="@((DateTime? d) => toDate = d)" Label="تا تاریخ" />
                <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="@(() => toDate = null)" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center">
                <MudSelect T="Guid?" @bind-Value="selectedProjectId" Label="پروژه" Placeholder="همهٔ پروژه‌ها" Clearable="true">
                    @foreach (var project in projects)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)project.Key)">@project.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4" OnClick="LoadHistoryAsync">
            اعمال فیلتر
        </MudButton>

        @if (isHistoryLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-4" />
        }
        else
        {
            <MudTable Items="historyItems" Hover="true">
                <HeaderContent>
                    <MudTh>تاریخ</MudTh>
                    <MudTh>شیفت</MudTh>
                    <MudTh>نوع ردیف</MudTh>
                    <MudTh>کارکرد مولد</MudTh>
                    <MudTh>مقدار خام</MudTh>
                    <MudTh>پروژه</MudTh>
                    <MudTh>منشأ</MudTh>
                    <MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="تاریخ">@JalaliCalendarConverter.Format(context.EntryDate.ToDateTime(TimeOnly.MinValue))</MudTd>
                    <MudTd DataLabel="شیفت">@(context.ShiftIndex is { } i ? (i + 1).ToString() : "—")</MudTd>
                    <MudTd DataLabel="نوع ردیف">@UsageDisplayNames.GetEntryKindName(context.Kind)</MudTd>
                    <MudTd DataLabel="کارکرد مولد">@context.OperationalUsageAmount.ToString("0.##")</MudTd>
                    <MudTd DataLabel="مقدار خام">@context.RawReadingValue.ToString("0.##")</MudTd>
                    <MudTd DataLabel="پروژه">@GetProjectName(context.ProjectId)</MudTd>
                    <MudTd DataLabel="منشأ">
                        @if (context.Origin == "AutoFilled")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@UsageDisplayNames.GetEntryOriginName(context.Origin)</MudChip>
                        }
                        else
                        {
                            @UsageDisplayNames.GetEntryOriginName(context.Origin)
                        }
                    </MudTd>
                    <MudTd DataLabel="عملیات">
                        @if (context.Kind == "ShiftReading" && context.ShiftIndex is not null)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="اصلاح مقدار"
                                           OnClick="@(() => OpenCorrectEntryReadingDialogAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" title="اصلاح مشخصات شیفت"
                                           OnClick="@(() => OpenCorrectEntryDetailsDialogAsync(context))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @if (historyItems.Count == 0)
            {
                <MudText Class="mt-4" Color="Color.Secondary">کارکردی برای این بازه ثبت نشده است.</MudText>
            }
        }
    </MudPaper>
}

@code {
    /// <summary>The device being viewed.</summary>
    [Parameter]
    public Guid MeterDeviceId { get; set; }

    /// <summary>The Holding the user was working in, carried along so the list page can be restored by the back button (chat, 2026-10-28).</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "holdingId")]
    public Guid? HoldingId { get; set; }

    private sealed class MeterDeviceDetail
    {
        public Guid Id { get; set; }
        public Guid OrganizationId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Unit { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? OwnerType { get; set; }
        public Guid? OwnerId { get; set; }
        public string? OwnerCode { get; set; }
        public string? OwnerName { get; set; }
        public decimal? DailyCapOverride { get; set; }
    }

    private sealed class UsageHistoryItem
    {
        public Guid UsageLedgerId { get; set; }
        public string OwnerType { get; set; } = string.Empty;
        public Guid OwnerId { get; set; }
        public DateOnly EntryDate { get; set; }
        public string Kind { get; set; } = string.Empty;
        public int? ShiftIndex { get; set; }
        public TimeOnly? ShiftStartTime { get; set; }
        public TimeOnly? ShiftEndTime { get; set; }
        public decimal RawReadingValue { get; set; }
        public decimal OperationalUsageAmount { get; set; }
        public Guid? OperatorId { get; set; }
        public Guid ProjectId { get; set; }
        public string Origin { get; set; } = string.Empty;
    }

    private sealed class UsageHistoryResult
    {
        public List<UsageHistoryItem> Items { get; set; } = [];
        public int TotalCount { get; set; }
    }

    private sealed class ProjectItem
    {
        public Guid Id { get; set; }
        public Guid OrganizationId { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class SearchProjectsResult
    {
        public List<ProjectItem> Items { get; set; } = [];
    }

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private MeterDeviceDetail? device;
    private List<UsageHistoryItem> historyItems = [];
    private Dictionary<Guid, string> projects = [];
    private DateTime? fromDate;
    private DateTime? toDate;
    private Guid? selectedProjectId;
    private bool isLoading = true;
    private bool isHistoryLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDeviceAsync();
        await LoadProjectsAsync();
        await LoadHistoryAsync();
    }

    private string GetListUrl()
    {
        var organizationId = device?.OrganizationId;

        return HoldingId is { } holdingId && organizationId is { } orgId
            ? $"/admin/meter-devices?holdingId={holdingId}&organizationId={orgId}"
            : "/admin/meter-devices";
    }

    private void GoBackToList() => Navigation.NavigateTo(GetListUrl());

    private string GetOwnerText()
    {
        if (device?.OwnerType is null)
        {
            return "نصب‌نشده";
        }

        // The Asset's code and name, never its raw identifier.
        return device.OwnerCode is null
            ? UsageDisplayNames.GetOwnerTypeName(device.OwnerType)
            : $"{device.OwnerCode} - {device.OwnerName}";
    }

    private string GetProjectName(Guid projectId) =>
        projects.TryGetValue(projectId, out var name) ? name : "—";

    private async Task LoadDeviceAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/meter-devices/{MeterDeviceId}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در دریافت اطلاعات دستگاه");
                return;
            }

            var stream = await response.Content.ReadAsStreamAsync();
            device = await JsonSerializer.DeserializeAsync<MeterDeviceDetail>(stream, JsonOptions);
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در دریافت اطلاعات دستگاه: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Loads the Organization's Projects so the history can show and filter by Project name instead of an identifier.</summary>
    private async Task LoadProjectsAsync()
    {
        if (device is null)
        {
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/projects?pageSize=200");

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<SearchProjectsResult>(content, JsonOptions);

                projects = (result?.Items ?? [])
                    .Where(p => p.OrganizationId == device.OrganizationId)
                    .OrderBy(p => p.Name)
                    .ToDictionary(p => p.Id, p => p.Name);
            }
        }
        catch
        {
            // Best effort: without names the Project column simply shows a dash.
        }
    }

    private async Task LoadHistoryAsync()
    {
        isHistoryLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var url = $"/api/v1/meter-devices/{MeterDeviceId}/usage-entries?page=1&pageSize=100";

            if (fromDate is not null)
            {
                url += $"&fromDate={DateOnly.FromDateTime(fromDate.Value):yyyy-MM-dd}";
            }

            if (toDate is not null)
            {
                url += $"&toDate={DateOnly.FromDateTime(toDate.Value):yyyy-MM-dd}";
            }

            if (selectedProjectId is { } projectId)
            {
                url += $"&projectId={projectId}";
            }

            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var stream = await response.Content.ReadAsStreamAsync();
                var result = await JsonSerializer.DeserializeAsync<UsageHistoryResult>(stream, JsonOptions);
                historyItems = result?.Items ?? [];
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در دریافت تاریخچهٔ کارکرد: {ex.Message}";
        }
        finally
        {
            isHistoryLoading = false;
        }
    }

    /// <summary>
    /// Fetches the single, absolute most recent entry for this device,
    /// ignoring whatever date/Project filters are currently applied to
    /// the on-screen history table (chat, 2026-09-29) — the delete
    /// confirmation must always target the Ledger's true latest entry,
    /// not whatever happens to be the filtered list's first row.
    /// </summary>
    private async Task<UsageHistoryItem?> FetchLatestEntryAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/meter-devices/{MeterDeviceId}/usage-entries?page=1&pageSize=1");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, "خطا در دریافت آخرین ردیف");
                return null;
            }

            var stream = await response.Content.ReadAsStreamAsync();
            var result = await JsonSerializer.DeserializeAsync<UsageHistoryResult>(stream, JsonOptions);
            return result?.Items.FirstOrDefault();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در دریافت آخرین ردیف: {ex.Message}";
            return null;
        }
    }

    private async Task OpenInstallDialogAsync()
    {
        if (device is null)
        {
            return;
        }

        var parameters = new DialogParameters<InstallMeterDeviceDialog>
        {
            { x => x.MeterDeviceId, MeterDeviceId },
            { x => x.DeviceName, device.Name },
            { x => x.OrganizationId, device.OrganizationId },
        };

        var dialog = await DialogService.ShowAsync<InstallMeterDeviceDialog>("نصب دستگاه", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDeviceAsync();
        }
    }

    private async Task OpenEditNameDialogAsync()
    {
        if (device is null)
        {
            return;
        }

        var parameters = new DialogParameters<EditMeterDeviceNameDialog>
        {
            { x => x.MeterDeviceId, MeterDeviceId },
            { x => x.CurrentName, device.Name },
        };

        var dialog = await DialogService.ShowAsync<EditMeterDeviceNameDialog>("ویرایش نام دستگاه", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDeviceAsync();
        }
    }

    private async Task OpenEditDailyCapDialogAsync()
    {
        if (device is null)
        {
            return;
        }

        var parameters = new DialogParameters<EditDailyCapDialog>
        {
            { x => x.MeterDeviceId, MeterDeviceId },
            { x => x.Unit, device.Unit },
            { x => x.CurrentCap, device.DailyCapOverride },
        };

        var dialog = await DialogService.ShowAsync<EditDailyCapDialog>("ویرایش سقف روزانه", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDeviceAsync();
        }
    }

    private async Task OpenRegisterShiftReadingDialogAsync()
    {
        var parameters = new DialogParameters<RegisterShiftReadingDialog> { { x => x.MeterDeviceId, MeterDeviceId } };
        var dialog = await DialogService.ShowAsync<RegisterShiftReadingDialog>("ثبت کارکرد شیفت", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDeviceAsync();
            await LoadHistoryAsync();
        }
    }

    private async Task OpenRebaseDialogAsync()
    {
        if (device is not { OwnerType: not null, OwnerId: not null, Unit: not null })
        {
            return;
        }

        var parameters = new DialogParameters<RebaseCounterDialog>
        {
            { x => x.OwnerType, device.OwnerType },
            { x => x.OwnerId, device.OwnerId.Value },
            { x => x.Unit, device.Unit },
            { x => x.OrganizationId, device.OrganizationId },
            { x => x.CurrentMeterDeviceId, MeterDeviceId },
        };

        var dialog = await DialogService.ShowAsync<RebaseCounterDialog>("بازتنظیم شمارنده", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDeviceAsync();
            await LoadHistoryAsync();
        }
    }

    private async Task OpenDeleteLatestDialogAsync()
    {
        errorMessage = null;

        var latest = await FetchLatestEntryAsync();

        if (latest is null)
        {
            errorMessage ??= "ردیفی برای حذف وجود ندارد.";
            return;
        }

        var parameters = new DialogParameters<DeleteLatestUsageEntryDialog>
        {
            { x => x.OwnerType, latest.OwnerType },
            { x => x.OwnerId, latest.OwnerId },
            { x => x.Unit, device?.Unit ?? string.Empty },
            { x => x.EntryDate, latest.EntryDate },
            { x => x.ShiftIndex, latest.ShiftIndex },
            { x => x.OperationalUsageAmount, latest.OperationalUsageAmount },
        };

        var dialog = await DialogService.ShowAsync<DeleteLatestUsageEntryDialog>("حذف آخرین ردیف", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadHistoryAsync();
        }
    }

    private async Task OpenCorrectEntryReadingDialogAsync(UsageHistoryItem item)
    {
        var parameters = new DialogParameters<CorrectEntryReadingDialog>
        {
            { x => x.OwnerType, item.OwnerType },
            { x => x.OwnerId, item.OwnerId },
            { x => x.Unit, device?.Unit ?? string.Empty },
            { x => x.EntryDate, item.EntryDate },
            { x => x.ShiftIndex, item.ShiftIndex!.Value },
            { x => x.CurrentRawReadingValue, item.RawReadingValue },
        };

        var dialog = await DialogService.ShowAsync<CorrectEntryReadingDialog>("اصلاح مقدار خوانده‌شده", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadHistoryAsync();
        }
    }

    private async Task OpenCorrectEntryDetailsDialogAsync(UsageHistoryItem item)
    {
        var parameters = new DialogParameters<CorrectEntryDetailsDialog>
        {
            { x => x.OwnerType, item.OwnerType },
            { x => x.OwnerId, item.OwnerId },
            { x => x.Unit, device?.Unit ?? string.Empty },
            { x => x.EntryDate, item.EntryDate },
            { x => x.ShiftIndex, item.ShiftIndex!.Value },
            { x => x.CurrentOperatorId, item.OperatorId },
            { x => x.CurrentShiftStartTime, item.ShiftStartTime ?? default },
            { x => x.CurrentShiftEndTime, item.ShiftEndTime ?? default },
            { x => x.OrganizationId, device?.OrganizationId },
        };

        var dialog = await DialogService.ShowAsync<CorrectEntryDetailsDialog>("اصلاح مشخصات شیفت", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadHistoryAsync();
        }
    }

    private Task ReportFailureAsync() => ExecuteLifecycleActionAsync("report-failure", "اعلام خرابی");

    private Task RecoverAsync() => ExecuteLifecycleActionAsync("recover", "بازیابی از خرابی");

    private Task RemoveAsync() => ExecuteLifecycleActionAsync("remove", "جدا کردن از مالک فعلی");

    private Task ArchiveAsync() => ExecuteLifecycleActionAsync("archive", "بایگانی نهایی");

    private async Task ExecuteLifecycleActionAsync(string actionSegment, string actionPersianName)
    {
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsync(
                $"/api/v1/meter-devices/{MeterDeviceId}/{actionSegment}",
                new StringContent(string.Empty));

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await UsageProblemMessages.DescribeAsync(response, $"خطا در «{actionPersianName}»");
                return;
            }

            await LoadDeviceAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در «{actionPersianName}»: {ex.Message}";
        }
    }
}
