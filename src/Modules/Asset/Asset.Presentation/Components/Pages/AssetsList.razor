@page "/admin/assets"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>دارایی‌ها</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">دارایی‌ها</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (organizations.Count > 1)
{
    <MudPaper Class="pa-4 mb-4">
        <MudSelect T="Guid?" Label="سازمان" Value="selectedOrganizationId" ValueChanged="OnOrganizationChangedAsync">
            @foreach (var org in organizations)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)org.Id)">@org.Name</MudSelectItem>
            }
        </MudSelect>
    </MudPaper>
}

@if (selectedOrganizationId is not null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo($"/admin/assets/create?organizationId={selectedOrganizationId}&holdingId={selectedHoldingId}"))">
        ثبت دارایی جدید
    </MudButton>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudTable Items="items" Hover="true">
            <HeaderContent>
                <MudTh>کد</MudTh>
                <MudTh>مدل</MudTh>
                <MudTh>شماره سریال</MudTh>
                <MudTh>پلاک</MudTh>
                <MudTh>سال ساخت</MudTh>
                <MudTh>رنگ</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh>عملیات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="کد">@context.Code</MudTd>
                <MudTd DataLabel="مدل">@GetAssetModelName(context.AssetModelId)</MudTd>
                <MudTd DataLabel="شماره سریال">@(context.SerialNumber ?? "-")</MudTd>
                <MudTd DataLabel="پلاک">@(context.LicensePlate ?? "-")</MudTd>
                <MudTd DataLabel="سال ساخت">@(context.ManufactureYear?.ToString() ?? "-")</MudTd>
                <MudTd DataLabel="رنگ">@context.Color</MudTd>
                <MudTd DataLabel="وضعیت">@TranslateStatus(context.Status)</MudTd>
                <MudTd DataLabel="عملیات">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/assets/{context.Id}"))">
                        جزئیات
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private sealed class OrganizationItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public Guid HoldingId { get; set; }
    }

    private sealed class AssetModelItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class AssetItem
    {
        public Guid Id { get; set; }
        public Guid OrganizationId { get; set; }
        public string Code { get; set; } = string.Empty;
        public Guid AssetModelId { get; set; }
        public string? SerialNumber { get; set; }
        public string? LicensePlate { get; set; }
        public int? ManufactureYear { get; set; }
        public string Color { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    private sealed class SearchAssetsResult
    {
        public List<AssetItem> Items { get; set; } = [];
    }

    private sealed class SearchOrganizationsResult
    {
        public List<OrganizationItem> Items { get; set; } = [];
    }

    private sealed class SearchAssetModelsResult
    {
        public List<AssetModelItem> Items { get; set; } = [];
    }

    private List<OrganizationItem> organizations = [];
    private List<AssetItem> items = [];
    private Dictionary<Guid, string> assetModelNames = [];
    private Guid? selectedOrganizationId;
    private Guid selectedHoldingId;
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/organizations?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در دریافت سازمان‌ها: {content}";
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<SearchOrganizationsResult>(content, new
System.Text.Json.JsonSerializerOptions
            { PropertyNameCaseInsensitive = true });
            organizations = result?.Items ?? [];

            if (organizations.Count == 1)
            {
                await OnOrganizationChangedAsync(organizations[0].Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    private async Task OnOrganizationChangedAsync(Guid? organizationId)
    {
        selectedOrganizationId = organizationId;
        selectedHoldingId = organizations.FirstOrDefault(o => o.Id == organizationId)?.HoldingId ?? Guid.Empty;
        await LoadAssetsAsync();
        if (selectedHoldingId != Guid.Empty)
        {
            await LoadAssetModelsAsync();
        }
    }

    private async Task LoadAssetsAsync()
    {
        if (selectedOrganizationId is null) return;

        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/assets?organizationId={selectedOrganizationId}&pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"خطا در دریافت دارایی‌ها: {content}";
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<SearchAssetsResult>(content, new
System.Text.Json.JsonSerializerOptions
            { PropertyNameCaseInsensitive = true });
            items = result?.Items ?? [];
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAssetModelsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/asset-models?holdingId={selectedHoldingId}&pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = System.Text.Json.JsonSerializer.Deserialize<SearchAssetModelsResult>(content, new
System.Text.Json.JsonSerializerOptions
                { PropertyNameCaseInsensitive = true });
                assetModelNames = (result?.Items ?? []).ToDictionary(a => a.Id, a => a.Name);
            }
        }
        catch
        {
            // Best effort
        }
    }

    private string GetAssetModelName(Guid assetModelId)
    {
        return assetModelNames.TryGetValue(assetModelId, out var name) ? name : assetModelId.ToString();
    }

    private static string TranslateStatus(string status) => status switch
    {
        "Registered" => "ثبت‌شده",
        "Commissioned" => "راه‌اندازی‌شده",
        "Operational" => "در حال بهره‌برداری",
        "Inactive" => "غیرفعال",
        "Retired" => "بازنشسته",
        "Disposed" => "اسقاط‌شده",
        _ => status
    };
}