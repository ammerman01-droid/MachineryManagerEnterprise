@page "/admin/asset-models/create"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@using MachineryManager.SharedKernel
@using System.Text.Json

<PageTitle>ثبت مدل دارایی</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ثبت مدل دارایی جدید</MudText>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else
{
    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
    }

    <MudPaper Class="pa-4" Style="max-width:600px;">
        <MudForm @ref="form" @bind-IsValid="@isValid">
            <MudTextField @bind-Value="name" Label="نام مدل" Required="true" RequiredError="نام الزامی است." MaxLength="200" />

            <div class="d-flex align-center gap-2 mt-4">
                <MudSelect T="Guid?" @bind-Value="companyId" Label="شرکت سازنده" Required="true"
                           RequiredError="انتخاب شرکت سازنده الزامی است.">
                    @foreach (var company in companies)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)company.Id)">@company.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => showAddCompany = !showAddCompany)">
                    افزودن شرکت جدید
                </MudButton>
            </div>

            @if (showAddCompany)
            {
                <div class="d-flex align-center gap-2 mt-2">
                    <MudTextField T="string" Label="نام شرکت جدید" @bind-Value="newCompanyName" MaxLength="200" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddCompanyAsync" Disabled="isAddingCompany">
                        @(isAddingCompany ? "..." : "ثبت شرکت")
                    </MudButton>
                </div>
            }

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">طول</MudText>
            <MudNumericField T="decimal?" @bind-Value="lengthValue" Label="مقدار طول" Min="0" />
            <MudSelect T="Guid?" @bind-Value="lengthUnitOfMeasurementId" Label="واحد طول" Class="mt-2">
                @foreach (var unit in dimensionUnits)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)unit.Id)">@unit.Name</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">عرض</MudText>
            <MudNumericField T="decimal?" @bind-Value="widthValue" Label="مقدار عرض" Min="0" />
            <MudSelect T="Guid?" @bind-Value="widthUnitOfMeasurementId" Label="واحد عرض" Class="mt-2">
                @foreach (var unit in dimensionUnits)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)unit.Id)">@unit.Name</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">ارتفاع</MudText>
            <MudNumericField T="decimal?" @bind-Value="heightValue" Label="مقدار ارتفاع" Min="0" />
            <MudSelect T="Guid?" @bind-Value="heightUnitOfMeasurementId" Label="واحد ارتفاع" Class="mt-2">
                @foreach (var unit in dimensionUnits)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)unit.Id)">@unit.Name</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">وزن</MudText>
            <MudNumericField T="decimal?" @bind-Value="weightValue" Label="مقدار وزن" Min="0" />
            <MudSelect T="Guid?" @bind-Value="weightUnitOfMeasurementId" Label="واحد وزن" Class="mt-2">
                @foreach (var unit in weightUnits)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)unit.Id)">@unit.Name</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">ظرفیت کاری (حجمی)</MudText>
            <MudNumericField T="decimal?" @bind-Value="workingCapacityVolumeValue" Label="مقدار ظرفیت (حجمی)" Min="0" />
            <MudSelect T="Guid?" @bind-Value="workingCapacityVolumeUnitOfMeasurementId" Label="واحد ظرفیت (حجمی)" Class="mt-2">
                @foreach (var unit in dimensionUnits)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)unit.Id)">@unit.Name</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">ظرفیت کاری (وزنی)</MudText>
            <MudNumericField T="decimal?" @bind-Value="workingCapacityWeightValue" Label="مقدار ظرفیت (وزنی)" Min="0" />
            <MudSelect T="Guid?" @bind-Value="workingCapacityWeightUnitOfMeasurementId" Label="واحد ظرفیت (وزنی)" Class="mt-2">
                @foreach (var unit in weightUnits)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)unit.Id)">@unit.Name</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync"
                       Disabled="@(!isValid || isSubmitting)" Class="mt-6">
                @if (isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>ثبت</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/asset-models"))" Class="mt-6 mr-2">
                بازگشت
            </MudButton>
        </MudForm>
    </MudPaper>
}

@code {
    /// <summary>Gets or sets the identifier of the Holding this Asset Model will belong to, supplied via the query string.</summary>
    [SupplyParameterFromQuery]
    public Guid HoldingId { get; set; }

    /// <summary>Represents a Company option in the manufacturer selection dropdown.</summary>
    private sealed class CompanyItem
    {
        /// <summary>Gets or sets the Company's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the Company's display name.</summary>
        public string Name { get; set; } = string.Empty;
    }

    /// <summary>Represents a Unit of Measurement option in a selection dropdown.</summary>
    private sealed class UnitOfMeasurementItem
    {
        /// <summary>Gets or sets the unit's unique identifier.</summary>
        public Guid Id { get; set; }

        /// <summary>Gets or sets the unit's display name.</summary>
        public string Name { get; set; } = string.Empty;

        /// <summary>Gets or sets the physical-quantity kind of the unit.</summary>
        public PhysicalQuantityKind Kind { get; set; }
    }

    private MudForm? form;
    private bool isValid;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showAddCompany;
    private bool isAddingCompany;
    private string name = string.Empty;
    private Guid? companyId;
    private string newCompanyName = string.Empty;
    private string? errorMessage;
    private List<CompanyItem> companies = [];

    private decimal? lengthValue;
    private Guid? lengthUnitOfMeasurementId;
    private decimal? widthValue;
    private Guid? widthUnitOfMeasurementId;
    private decimal? heightValue;
    private Guid? heightUnitOfMeasurementId;
    private decimal? weightValue;
    private Guid? weightUnitOfMeasurementId;
    private decimal? workingCapacityVolumeValue;
    private Guid? workingCapacityVolumeUnitOfMeasurementId;
    private decimal? workingCapacityWeightValue;
    private Guid? workingCapacityWeightUnitOfMeasurementId;

    private List<UnitOfMeasurementItem> dimensionUnits = [];
    private List<UnitOfMeasurementItem> weightUnits = [];

    /// <summary>Loads the Holding's Companies and Units of Measurement (split by physical-quantity kind) for the form's dropdowns.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");

            var companyResponse = await client.GetAsync($"/api/v1/companies?holdingId={HoldingId}");
            var companyContent = await companyResponse.Content.ReadAsStringAsync();

            if (companyResponse.IsSuccessStatusCode)
            {
                companies = JsonSerializer.Deserialize<List<CompanyItem>>(
                    companyContent, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت شرکت‌ها: {companyContent}";
            }

            var unitResponse = await client.GetAsync($"/api/v1/units-of-measurement?holdingId={HoldingId}");
            var unitContent = await unitResponse.Content.ReadAsStringAsync();

            if (unitResponse.IsSuccessStatusCode)
            {
                var units = JsonSerializer.Deserialize<List<UnitOfMeasurementItem>>(
                    unitContent, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];

                dimensionUnits = units.Where(u => u.Kind == PhysicalQuantityKind.Dimension).ToList();
                weightUnits = units.Where(u => u.Kind == PhysicalQuantityKind.Weight).ToList();
            }
            else
            {
                errorMessage = $"خطا در دریافت واحدهای اندازه‌گیری: {unitContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Registers a new Company inline, without leaving this page.</summary>
    private async Task AddCompanyAsync()
    {
        if (string.IsNullOrWhiteSpace(newCompanyName))
        {
            return;
        }

        isAddingCompany = true;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync(
                "/api/v1/companies", new { HoldingId, Name = newCompanyName });
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                newCompanyName = string.Empty;
                showAddCompany = false;

                var companyResponse = await client.GetAsync($"/api/v1/companies?holdingId={HoldingId}");
                var companyContent = await companyResponse.Content.ReadAsStringAsync();

                if (companyResponse.IsSuccessStatusCode)
                {
                    companies = JsonSerializer.Deserialize<List<CompanyItem>>(
                        companyContent, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
                }
            }
            else
            {
                errorMessage = $"خطا در ثبت شرکت: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isAddingCompany = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (form is null || !isValid)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync(
                "/api/v1/asset-models",
                new
                {
                    HoldingId,
                    Name = name,
                    CompanyId = companyId,
                    LengthValue = lengthValue,
                    LengthUnitOfMeasurementId = lengthUnitOfMeasurementId,
                    WidthValue = widthValue,
                    WidthUnitOfMeasurementId = widthUnitOfMeasurementId,
                    HeightValue = heightValue,
                    HeightUnitOfMeasurementId = heightUnitOfMeasurementId,
                    WeightValue = weightValue,
                    WeightUnitOfMeasurementId = weightUnitOfMeasurementId,
                    WorkingCapacityVolumeValue = workingCapacityVolumeValue,
                    WorkingCapacityVolumeUnitOfMeasurementId = workingCapacityVolumeUnitOfMeasurementId,
                    WorkingCapacityWeightValue = workingCapacityWeightValue,
                    WorkingCapacityWeightUnitOfMeasurementId = workingCapacityWeightUnitOfMeasurementId
                });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/admin/asset-models");
                return;
            }

            errorMessage = $"خطا در ثبت مدل: {await response.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}