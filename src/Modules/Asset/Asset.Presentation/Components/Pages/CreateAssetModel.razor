@page "/admin/asset-models/create"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>ثبت مدل دارایی</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ثبت مدل دارایی جدید</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

<MudPaper Class="pa-4" Style="max-width:500px;">
    <MudForm @ref="form" @bind-IsValid="@isValid">
        <MudTextField @bind-Value="name" Label="نام مدل" Required="true" RequiredError="نام الزامی است." MaxLength="200" />
        <MudTextField @bind-Value="manufacturer" Label="سازنده" Required="true" RequiredError="سازنده الزامی است." MaxLength="200" Class="mt-2" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync"
                   Disabled="@(!isValid || isSubmitting)" Class="mt-4">
            @if (isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>ثبت</span>
            }
        </MudButton>

        <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/asset-models"))" Class="mt-4 mr-2">
            بازگشت
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    [SupplyParameterFromQuery]
    public Guid HoldingId { get; set; }

    private MudForm? form;
    private bool isValid;
    private bool isSubmitting;
    private string name = string.Empty;
    private string manufacturer = string.Empty;
    private string? errorMessage;

    private async Task SubmitAsync()
    {
        if (form is null || !isValid)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsJsonAsync(
                "/api/v1/asset-models",
                new { HoldingId, Name = name, Manufacturer = manufacturer });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/admin/asset-models");
                return;
            }

            errorMessage = $"خطا در ثبت مدل: {await response.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}