@page "/admin/assets/{AssetId:guid}"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@using System.Text.Json

<PageTitle>جزئیات دارایی</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">جزئیات دارایی</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (asset is not null)
{
    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudField Label="کد شناسایی" Variant="Variant.Outlined">@asset.Code</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="نام" Variant="Variant.Outlined">@asset.Name</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="مدل دارایی" Variant="Variant.Outlined">@GetAssetModelName(asset.AssetModelId)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="رنگ" Variant="Variant.Outlined">@GetColorName(asset.ColorId)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="پروژه" Variant="Variant.Outlined">@GetProjectName(asset.ProjectId)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="شماره سریال" Variant="Variant.Outlined">@(asset.SerialNumber ?? "-")</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="شماره شاسی" Variant="Variant.Outlined">@(asset.ChassisNumber ?? "-")</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="شماره بدنه" Variant="Variant.Outlined">@(asset.BodyNumber ?? "-")</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="VIN" Variant="Variant.Outlined">@(asset.Vin ?? "-")</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="پلاک" Variant="Variant.Outlined">@(asset.LicensePlate ?? "-")</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="سال ساخت" Variant="Variant.Outlined">@(asset.ManufactureYear?.ToString() ?? "-")</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="واحد قرائت کنتر" Variant="Variant.Outlined">@UnitDisplayNames.GetMeterReadingUnitName(asset.MeterReadingUnit)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="سوخت اصلی" Variant="Variant.Outlined">@GetFuelKindDisplayName(asset.PrimaryFuelKind)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="واحد شمارش سوخت اصلی" Variant="Variant.Outlined">@UnitDisplayNames.GetFuelUnitName(asset.PrimaryFuelUnit)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="سوخت دوم" Variant="Variant.Outlined">@GetFuelKindDisplayName(asset.SecondaryFuelKind)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="واحد شمارش سوخت دوم" Variant="Variant.Outlined">@UnitDisplayNames.GetFuelUnitName(asset.SecondaryFuelUnit)</MudField>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudField Label="وضعیت" Variant="Variant.Outlined">@TranslateStatus(asset.Status)</MudField>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <div class="d-flex gap-2 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(() => Navigation.NavigateTo($"/admin/assets/{asset.Id}/edit"))">
                ویرایش
            </MudButton>

            @if (asset.Status == "Registered")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => TransitionAsync("commission"))">
                    راه‌اندازی
                </MudButton>
            }

            @if (asset.Status is "Commissioned" or "Inactive")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => TransitionAsync("activate"))">
                    فعال‌سازی
                </MudButton>
            }

            @if (asset.Status == "Operational")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => TransitionAsync("deactivate"))">
                    غیرفعال‌سازی موقت
                </MudButton>
            }

            @if (asset.Status is "Operational" or "Inactive")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => TransitionAsync("retire"))">
                    بازنشسته‌سازی
                </MudButton>
            }

            @if (asset.Status == "Retired")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => TransitionAsync("dispose"))">
                    اسقاط
                </MudButton>
            }

            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/admin/assets"))">
                بازگشت به لیست
            </MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public Guid AssetId { get; set; }

    private sealed class AssetDetail
    {
        public Guid Id { get; set; }
        public Guid OrganizationId { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public Guid AssetModelId { get; set; }
        public Guid ColorId { get; set; }
        public string? SerialNumber { get; set; }
        public string? ChassisNumber { get; set; }
        public string? BodyNumber { get; set; }
        public string? Vin { get; set; }
        public string? LicensePlate { get; set; }
        public int? ManufactureYear { get; set; }
        public string Status { get; set; } = string.Empty;
        public Guid ProjectId { get; set; }
        public string? MeterReadingUnit { get; set; }
        public string? PrimaryFuelKind { get; set; }
        public string? PrimaryFuelUnit { get; set; }
        public string? SecondaryFuelKind { get; set; }
        public string? SecondaryFuelUnit { get; set; }
    }

    private sealed class OrganizationItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public Guid? HoldingId { get; set; }
    }

    private sealed class NamedItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class ProjectItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public Guid OrganizationId { get; set; }
    }

    private sealed class SearchOrganizationsResult { public List<OrganizationItem> Items { get; set; } = []; }
    private sealed class SearchNamedItemsResult { public List<NamedItem> Items { get; set; } = []; }
    private sealed class SearchProjectsResult { public List<ProjectItem> Items { get; set; } = []; }

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private AssetDetail? asset;
    private bool isLoading = true;
    private string? errorMessage;

    private Dictionary<Guid, string> assetModelNames = [];
    private Dictionary<Guid, string> colorNames = [];
    private Dictionary<Guid, string> projectNames = [];

    private string GetAssetModelName(Guid id) => assetModelNames.TryGetValue(id, out var n) ? n : id.ToString();
    private string GetColorName(Guid id) => colorNames.TryGetValue(id, out var n) ? n : id.ToString();
    private string GetProjectName(Guid id) => projectNames.TryGetValue(id, out var n) ? n : id.ToString();

    private static string GetFuelKindDisplayName(string? kind) => kind switch
    {
        "Diesel" => "گازوئیل",
        "Gasoline" => "بنزین",
        "Gas" => "گاز",
        null => "-",
        _ => kind
    };

    private static string TranslateStatus(string status) => status switch
    {
        "Registered" => "ثبت‌شده",
        "Commissioned" => "راه‌اندازی‌شده",
        "Operational" => "در حال بهره‌برداری",
        "Inactive" => "غیرفعال",
        "Retired" => "بازنشسته",
        "Disposed" => "اسقاط‌شده",
        _ => status
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAssetAsync();

        if (asset is not null)
        {
            var org = await LoadOrganizationAsync(asset.OrganizationId);
            await LoadProjectNamesAsync(asset.OrganizationId);

            if (org?.HoldingId is { } holdingId)
            {
                await LoadAssetModelNamesAsync(holdingId);
                await LoadColorNamesAsync(holdingId);
            }
        }

        isLoading = false;
    }

    private async Task LoadAssetAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/assets/{AssetId}");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                asset = JsonSerializer.Deserialize<AssetDetail>(content, JsonOptions);
            }
            else
            {
                errorMessage = $"خطا در دریافت دارایی: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }

    private async Task<OrganizationItem?> LoadOrganizationAsync(Guid organizationId)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/organizations?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchOrganizationsResult>(content, JsonOptions);
                return result?.Items.FirstOrDefault(o => o.Id == organizationId);
            }
        }
        catch
        {
            // Best effort
        }

        return null;
    }

    private async Task LoadProjectNamesAsync(Guid organizationId)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/projects?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchProjectsResult>(content, JsonOptions);
                projectNames = (result?.Items ?? [])
                    .Where(p => p.OrganizationId == organizationId)
                    .ToDictionary(p => p.Id, p => p.Name);
            }
        }
        catch
        {
            // Best effort
        }
    }

    private async Task LoadAssetModelNamesAsync(Guid holdingId)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/asset-models?holdingId={holdingId}&pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchNamedItemsResult>(content, JsonOptions);
                assetModelNames = (result?.Items ?? []).ToDictionary(a => a.Id, a => a.Name);
            }
        }
        catch
        {
            // Best effort
        }
    }

    private async Task LoadColorNamesAsync(Guid holdingId)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/colors?holdingId={holdingId}");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<List<NamedItem>>(content, JsonOptions) ?? [];
                colorNames = result.ToDictionary(c => c.Id, c => c.Name);
            }
        }
        catch
        {
            // Best effort
        }
    }

    private async Task TransitionAsync(string action)
    {
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.PostAsync($"/api/v1/assets/{AssetId}/{action}", null);
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                await LoadAssetAsync();
            }
            else
            {
                errorMessage = $"خطا: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }
}
