@inherits LayoutComponentBase

<div class="auth-shell">
    <div class="auth-form-panel">
        <div class="auth-form-panel-inner">
            @Body
        </div>
    </div>
    <div class="auth-image-panel">
        <img src="/images/login-hero.jpg" alt="" class="auth-image" />
    </div>
</div>

<style>
    html, body {
        height: 100%;
        margin: 0;
        overflow: hidden;
    }

    .auth-shell {
        height: 100vh;
        display: flex;
        align-items: stretch;
        background: #f5f6f8;
        overflow: hidden;
    }

    .auth-form-panel {
        flex: 1 1 45%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        overflow: hidden;
        min-width: 0;
    }

    .auth-form-panel-inner {
        width: 100%;
        max-width: 380px;
    }

    .auth-image-panel {
        flex: 1 1 55%;
        padding: 1.5rem;
        display: none;
        overflow: hidden;
        min-width: 0;
    }

    .auth-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 28px;
    }

    /* Image is intentionally hidden below this width — on phones,
       showing it would either force a scrollbar or squeeze the form
       too much (chat, 2026-09-07). */
    @@media (min-width: 900px) {
        .auth-image-panel {
            display: block;
        }
    }
</style>