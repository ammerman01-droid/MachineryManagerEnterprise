@page "/admin/personnel"
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>پرسنل</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">مدیریت پرسنل</MudText>

<MudSelect T="Guid?" Label="Holding" Placeholder="یک هلدینگ را انتخاب کنید" @bind-Value="selectedHoldingId" @bind-Value:after="OnHoldingChangedAsync" Class="mb-4">
    @foreach (var holding in holdings)
    {
        <MudSelectItem T="Guid?" Value="@((Guid?)holding.Id)">@holding.Name</MudSelectItem>
    }
</MudSelect>

@if (selectedHoldingId is not null)
{
    <MudSelect T="Guid?" Label="Organization" Placeholder="یک سازمان را انتخاب کنید" @bind-Value="selectedOrganizationId" @bind-Value:after="OnOrganizationChangedAsync" Class="mb-4">
        @foreach (var organization in organizations)
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)organization.Id)">@organization.Name</MudSelectItem>
        }
    </MudSelect>
}

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@errorMessage</MudAlert>
}

@if (selectedOrganizationId is not null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo($"/admin/personnel/create?organizationId={selectedOrganizationId}"))">
        پرسنل جدید
    </MudButton>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (selectedOrganizationId is not null && personnel.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">هیچ پرسنلی برای این Organization ثبت نشده است.</MudText>
}
else if (personnel.Count > 0)
{
    <MudTable Items="@personnel" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>نام</MudTh>
            <MudTh>نام خانوادگی</MudTh>
            <MudTh>کد پرسنلی</MudTh>
            <MudTh>تعداد گواهی‌نامه</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.FirstName</MudTd>
            <MudTd DataLabel="نام خانوادگی">@context.LastName</MudTd>
            <MudTd DataLabel="کد پرسنلی">@context.PersonnelCode</MudTd>
            <MudTd DataLabel="تعداد گواهی‌نامه">@context.DrivingLicenses.Count</MudTd>
            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/personnel/edit/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private sealed class HoldingItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class OrganizationItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class PersonnelDrivingLicenseItem
    {
        public Guid DrivingLicenseTypeId { get; set; }
        public DateOnly ExpiryDate { get; set; }
    }

    private sealed class PersonnelItem
    {
        public Guid Id { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string PersonnelCode { get; set; } = string.Empty;
        public List<PersonnelDrivingLicenseItem> DrivingLicenses { get; set; } = [];
    }

    private sealed class SearchResult<TItem>
    {
        public List<TItem> Items { get; set; } = [];
    }

    private List<HoldingItem> holdings = [];
    private List<OrganizationItem> organizations = [];
    private List<PersonnelItem> personnel = [];
    private Guid? selectedHoldingId;
    private Guid? selectedOrganizationId;
    private bool isLoading = true;
    private string? errorMessage;

    /// <summary>Loads the list of Holdings when the page is first rendered.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync("/api/v1/holdings?pageSize=200");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchResult<HoldingItem>>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                holdings = result?.Items ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت Holding ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Reloads the Organization list whenever the selected Holding changes.</summary>
    private async Task OnHoldingChangedAsync()
    {
        organizations = [];
        selectedOrganizationId = null;
        personnel = [];

        if (selectedHoldingId is null)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/organizations?holdingId={selectedHoldingId}");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<SearchResult<OrganizationItem>>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                organizations = result?.Items ?? JsonSerializer.Deserialize<List<OrganizationItem>>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت Organization ها: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Reloads the Personnel list whenever the selected Organization changes.</summary>
    private async Task OnOrganizationChangedAsync()
    {
        if (selectedOrganizationId is null)
        {
            personnel = [];
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.GetAsync($"/api/v1/personnel?organizationId={selectedOrganizationId}");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                personnel = JsonSerializer.Deserialize<List<PersonnelItem>>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                errorMessage = $"خطا در دریافت پرسنل: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteAsync(PersonnelItem item)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "حذف",
            $"آیا از حذف \"{item.FirstName} {item.LastName}\" مطمئن هستید؟",
            yesText: "حذف", cancelText: "انصراف");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("InternalApi");
            var response = await client.DeleteAsync($"/api/v1/personnel/{item.Id}");

            if (response.IsSuccessStatusCode)
            {
                personnel.Remove(item);
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = $"خطا در حذف: {content}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا: {ex.Message}";
        }
    }
}
