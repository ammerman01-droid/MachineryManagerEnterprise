<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MachineryManager.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="RenderModeForRequest()" />
</head>

<body>
    <Routes @rendermode="RenderModeForRequest()" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    /// <summary>
    /// Cascaded from the current request; used to decide per-request whether
    /// the page tree should render statically or interactively.
    /// </summary>
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Identity pages (Login, and any future Identity pages under
    /// /identity/*) must stay Static SSR: SignInManager needs to write the
    /// authentication cookie directly to the HTTP response, which is only
    /// possible before the response has started — a constraint that an
    /// Interactive Server circuit cannot satisfy. Every other page uses
    /// InteractiveServer per the project's Global Interactivity decision.
    /// </summary>
    private IComponentRenderMode? RenderModeForRequest()
    {
        if (HttpContext.Request.Path.StartsWithSegments("/identity"))
        {
            return null;
        }

        return InteractiveServer;
    }
}