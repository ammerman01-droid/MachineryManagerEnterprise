@page "/Error"
@using System.Diagnostics

<PageTitle>خطا</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        خطایی در پردازش درخواست شما رخ داد.
    </MudAlert>

    @if (ShowRequestId)
    {
        <MudText Typo="Typo.body2" Class="mb-4">
            <strong>شناسهٔ درخواست:</strong> <code>@RequestId</code>
        </MudText>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">حالت توسعه (Development)</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            با فعال‌سازی محیط Development، جزئیات بیشتری دربارهٔ خطای رخ‌داده نمایش داده می‌شود.
        </MudText>
        <MudText Typo="Typo.body2">
            محیط Development نباید در برنامه‌های مستقرشده (production) فعال باشد، چون می‌تواند اطلاعات حساس exceptionها را به کاربر نهایی نمایش دهد.
            برای دیباگ محلی، متغیر محیطی <code>ASPNETCORE_ENVIRONMENT</code> را برابر <code>Development</code> قرار داده و برنامه را دوباره اجرا کنید.
        </MudText>
    </MudPaper>
</MudContainer>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}