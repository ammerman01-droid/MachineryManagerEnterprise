@inject NavigationManager Navigation
@implements IDisposable

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        خانه
    </MudNavLink>

    @foreach (var category in categories)
    {
        <MudNavGroup Title="@category.Title" Icon="@category.Icon" Expanded="@(expandedCategoryKey == category.Key)"
                     ExpandedChanged="@((bool isExpanded) => OnGroupExpandedChanged(category.Key, isExpanded))">
            @foreach (var link in category.Links)
            {
                <MudNavLink Href="@link.Href" Icon="@link.Icon">@link.Title</MudNavLink>
            }
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    /// <summary>
    /// The key of the currently expanded category, or <see langword="null"/>
    /// when all are collapsed. Because each <see cref="MudNavGroup"/>'s
    /// <c>Expanded</c> is bound one-way to "does this key match", setting
    /// this field to a new key automatically collapses whichever group was
    /// previously open — no manual bookkeeping needed beyond this field.
    /// </summary>
    private string? expandedCategoryKey;

    /// <summary>
    /// The fixed set of nav categories shown in the drawer, grouped per
    /// the approved menu structure (chat, 2026-09-10).
    /// </summary>
    private readonly List<NavMenuCategory> categories = new()
    {
        new NavMenuCategory("structure", "ساختار سازمانی", Icons.Material.Filled.AccountTree, new List<NavMenuLink>
        {
            new("هلدینگ‌ها", "admin/holdings", Icons.Material.Filled.Domain),
            new("سازمان‌ها", "admin/organizations", Icons.Material.Filled.Business),
            new("پروژه‌ها", "admin/projects", Icons.Material.Filled.FolderSpecial),
        }),
        new NavMenuCategory("base-data", "اطلاعات پایه", Icons.Material.Filled.Tune, new List<NavMenuLink>
        {
            new("رنگ‌ها", "admin/colors", Icons.Material.Filled.Palette),
            new("واحدهای اندازه‌گیری", "admin/units-of-measurement", Icons.Material.Filled.Straighten),
            new("شرکت‌های سازنده", "admin/companies", Icons.Material.Filled.Apartment),
            new("انواع سوخت", "admin/fuel-types", Icons.Material.Filled.LocalGasStation),
        }),
        new NavMenuCategory("work-calendar", "تقویم کاری", Icons.Material.Filled.CalendarToday, new List<NavMenuLink>
        {
            new("تقویم کاری", "admin/work-calendar", Icons.Material.Filled.CalendarToday),
        }),
        new NavMenuCategory("personnel", "پرسنل", Icons.Material.Filled.Person, new List<NavMenuLink>
        {
            new("پرسنل", "admin/personnel", Icons.Material.Filled.People),
            new("سمت‌های شغلی", "admin/job-titles", Icons.Material.Filled.PhotoAlbum),
            new("گواهی نامه", "admin/driving-license-types", Icons.Material.Filled.PhotoAlbum),
        }),
        new NavMenuCategory("assets", "دارایی‌ها", Icons.Material.Filled.PrecisionManufacturing, new List<NavMenuLink>
        {
            new("مدل‌های دارایی", "admin/asset-models", Icons.Material.Filled.Construction),
            new("مدل‌های موتور", "admin/engine-models", Icons.Material.Filled.Settings),
            new("دارایی‌ها", "admin/assets", Icons.Material.Filled.LocalShipping),
        }),
        new NavMenuCategory("consumption", "مصرف", Icons.Material.Filled.LocalGasStation, new List<NavMenuLink>
        {
         new("سوخت‌گیری‌ها", "admin/fuel-consumptions", Icons.Material.Filled.LocalGasStation),
         new("گزارش‌های سرریز روانکار", "admin/lubricant-overflow-reports", Icons.Material.Filled.ReportProblem),
         new("انواع روانکار", "admin/lubricant-types", Icons.Material.Filled.Water),
         new("قسمت‌های سرریز", "admin/overflow-components", Icons.Material.Filled.Build),
         new("قفل گزارش‌های مصرف", "admin/consumption-freeze-setting", Icons.Material.Filled.Lock),
        }),
        new NavMenuCategory("maintenance", "نگهداری و تعمیرات", Icons.Material.Filled.Handyman, new List<NavMenuLink>
        {
            new("دستورهای کار", "maintenance/work-orders", Icons.Material.Filled.Assignment),
        }),
        new NavMenuCategory("access", "دسترسی کاربران", Icons.Material.Filled.AdminPanelSettings, new List<NavMenuLink>
        {
            new("پروفایل‌ها", "admin/profiles", Icons.Material.Filled.Security),
            new("کاربران", "admin/users", Icons.Material.Filled.People),
        }),
        new NavMenuCategory("reports", "گزارش‌ها", Icons.Material.Filled.Assessment, new List<NavMenuLink>
        {
            new("گزارش رخدادها", "admin/audit-log", Icons.Material.Filled.EventNote),
        }),
    };

    protected override void OnInitialized()
    {
        SetExpandedCategoryFromCurrentUri();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SetExpandedCategoryFromCurrentUri();
        StateHasChanged();
    }

    private void SetExpandedCategoryFromCurrentUri()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');

        // Fix (chat, 2026-09-15): a Project's Work Calendar lives under
        // "admin/projects/{id}/work-calendar", which is also a prefix
        // match for the "structure" category's own "admin/projects" link.
        // Check this more specific case first so the "work-calendar"
        // category wins whenever the path is actually about a calendar.
        if (relativePath.Contains("/work-calendar", StringComparison.OrdinalIgnoreCase) ||
            relativePath.StartsWith("admin/work-calendars/", StringComparison.OrdinalIgnoreCase))
        {
            expandedCategoryKey = "work-calendar";
            return;
        }

        var matchedCategory = categories.FirstOrDefault(category =>
            category.Links.Any(link => MatchesCurrentPath(relativePath, link.Href)));

        if (matchedCategory is not null)
        {
            expandedCategoryKey = matchedCategory.Key;
        }
    }

    private static bool MatchesCurrentPath(string relativePath, string href) =>
        relativePath.Equals(href, StringComparison.OrdinalIgnoreCase) ||
        relativePath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Handles a group's expand/collapse toggle. Expanding sets this as
    /// the sole open category (collapsing whichever other was open);
    /// collapsing the currently-open one clears it entirely.
    /// </summary>
    private void OnGroupExpandedChanged(string key, bool isExpanded) =>
        expandedCategoryKey = isExpanded ? key : null;

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private sealed record NavMenuLink(string Title, string Href, string Icon);

    private sealed record NavMenuCategory(string Key, string Title, string Icon, IReadOnlyList<NavMenuLink> Links);
}